<?xml version="1.0"?>
<robot name="dogzilla_s2" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    DOGZILLA S2 description framework.

    Sensor frame names and the LiDAR/IMU transforms preserve the current
    working Cartographer setup. Body, leg, and camera dimensions are
    provisional and must be measured on the physical robot before this model
    is used for anything beyond TF/visualization development.
  -->
  <xacro:include filename="dogzilla_leg.xacro"/>

  <xacro:arg name="camera_x" default="0.150"/>
  <xacro:arg name="camera_y" default="0.000"/>
  <xacro:arg name="camera_z" default="0.075"/>
  <xacro:arg name="camera_roll" default="0.000"/>
  <xacro:arg name="camera_pitch" default="0.000"/>
  <xacro:arg name="camera_yaw" default="0.000"/>
  <xacro:arg name="include_lidar" default="true"/>
  <xacro:arg name="include_imu" default="true"/>

  <xacro:property name="base_length" value="0.300"/>
  <xacro:property name="base_width" value="0.160"/>
  <xacro:property name="base_height" value="0.080"/>
  <xacro:property name="base_mass" value="4.000"/>
  <xacro:property name="hip_offset" value="0.040"/>
  <xacro:property name="upper_leg_length" value="0.100"/>
  <xacro:property name="lower_leg_length" value="0.110"/>
  <xacro:property name="leg_radius" value="0.012"/>
  <xacro:property name="foot_radius" value="0.018"/>

  <material name="dogzilla_body_material">
    <color rgba="0.08 0.08 0.09 1.0"/>
  </material>
  <material name="dogzilla_leg_material">
    <color rgba="0.20 0.20 0.22 1.0"/>
  </material>
  <material name="dogzilla_foot_material">
    <color rgba="0.04 0.04 0.04 1.0"/>
  </material>
  <material name="dogzilla_sensor_material">
    <color rgba="0.10 0.35 0.80 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <mass value="${base_mass}"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia
        ixx="${base_mass * (base_width * base_width + base_height * base_height) / 12.0}"
        ixy="0" ixz="0"
        iyy="${base_mass * (base_length * base_length + base_height * base_height) / 12.0}"
        iyz="0"
        izz="${base_mass * (base_length * base_length + base_width * base_width) / 12.0}"/>
    </inertial>
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="dogzilla_body_material"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
  </link>

  <!--
    Proposed corner assignment only: 1 front-left, 2 front-right,
    3 rear-left, 4 rear-right. Confirm it against the physical motor readback
    before enabling robot_state_publisher in an operational launch.
  -->
  <xacro:dogzilla_leg
    leg="1" parent="base_link" mount_x="0.115" mount_y="0.080" side="1"/>
  <xacro:dogzilla_leg
    leg="2" parent="base_link" mount_x="0.115" mount_y="-0.080" side="-1"/>
  <xacro:dogzilla_leg
    leg="3" parent="base_link" mount_x="-0.115" mount_y="0.080" side="1"/>
  <xacro:dogzilla_leg
    leg="4" parent="base_link" mount_x="-0.115" mount_y="-0.080" side="-1"/>

  <xacro:if value="$(arg include_lidar)">
    <link name="laser_frame">
      <visual>
        <geometry>
          <cylinder radius="0.036" length="0.025"/>
        </geometry>
        <material name="dogzilla_sensor_material"/>
      </visual>
    </link>
    <joint name="laser_mount_joint" type="fixed">
      <origin xyz="0.000 0.000 0.180" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="laser_frame"/>
    </joint>
  </xacro:if>

  <xacro:if value="$(arg include_imu)">
    <link name="imu_link"/>
    <joint name="imu_mount_joint" type="fixed">
      <origin xyz="0.085 0.000 0.070" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="imu_link"/>
    </joint>
  </xacro:if>

  <link name="camera_link">
    <visual>
      <geometry>
        <box size="0.040 0.050 0.035"/>
      </geometry>
      <material name="dogzilla_sensor_material"/>
    </visual>
  </link>
  <joint name="camera_mount_joint" type="fixed">
    <origin
      xyz="$(arg camera_x) $(arg camera_y) $(arg camera_z)"
      rpy="$(arg camera_roll) $(arg camera_pitch) $(arg camera_yaw)"/>
    <parent link="base_link"/>
    <child link="camera_link"/>
  </joint>

  <!-- REP-103 optical convention: +z forward, +x right, +y down. -->
  <link name="camera_optical_frame"/>
  <joint name="camera_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57079632679 0 -1.57079632679"/>
    <parent link="camera_link"/>
    <child link="camera_optical_frame"/>
  </joint>
</robot>
