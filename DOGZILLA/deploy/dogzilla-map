capture_object_dataset() {
    local label="${1:-}"
    local count="${2:-60}"
    local interval="${3:-1.0}"
    local capture_service
    if [[ ! "${label}" =~ ^[a-z][a-z0-9_-]{0,31}$ ]]; then
        printf 'LABEL must match ^[a-z][a-z0-9_-]{0,31}$.\n' >&2
        return 2
    fi
    if [[ ! "${count}" =~ ^[0-9]+$ ]] \
        || ((count < 1 || count > 500)); then
        printf 'COUNT must be an integer from 1 to 500.\n' >&2
        return 2
    fi
    if ! python3 -c \
        'import sys; value=float(sys.argv[1]); assert 0.1 <= value <= 30.0' \
        "${interval}" 2>/dev/null; then
        printf 'INTERVAL must be from 0.1 to 30 seconds.\n' >&2
        return 2
    fi
    if perception_is_running; then
        capture_service="${PERCEPTION_SERVICE_NAME}"
    elif vision_is_running; then
        capture_service="${VISION_SERVICE_NAME}"
    else
        printf '%s\n' \
            'Camera perception is not running.' \
            'Start it with "dogzilla vision raw", then retry.' >&2
        return 1
    fi
    mkdir -p "${REPO_ROOT}/datasets/${label}/unlabeled"
    compose exec --no-TTY "${capture_service}" \
        bash -lc '
            source /opt/ros/humble/setup.bash
            source /root/yahboomcar_ws/install/setup.bash
            python3 -m dogzilla_slam.dataset_capture "$@"
        ' bash \
            --label "${label}" \
            --count "${count}" \
            --interval "${interval}" \
            --output-root /datasets
}

check_object_detection() {
    local label="${1:-}"
    local duration="${2:-15}"
    local floor_option="${3:-}"
    local mode='objects'
    local report_directory="${REPO_ROOT}/logs/object-checks"
    local report_file
    local report_temporary
    local service
    local slug
    local status=0
    local -a floor_arguments=()

    if (($# < 1 || $# > 3)); then
        printf '%s\n' \
            'Usage: dogzilla object-check LABEL [SECONDS] [--floor]' >&2
        return 2
    fi
    if [[ ! "${label}" =~ ^[A-Za-z][A-Za-z0-9_-]{0,39}$ ]]; then
        printf '%s\n' \
            'LABEL must use letters, numbers, underscores, or hyphens.' >&2
        return 2
    fi
    if ! python3 -c '
import math, sys
value = float(sys.argv[1])
raise SystemExit(0 if math.isfinite(value) and 2 <= value <= 120 else 1)
' "${duration}" 2>/dev/null; then
        printf 'SECONDS must be from 2 to 120.\n' >&2
        return 2
    fi
    case "${floor_option}" in
        '') ;;
        --floor)
            mode='floor-hazards'
            floor_arguments+=(--require-floor)
            ;;
        *)
            printf 'The only optional flag is --floor.\n' >&2
            return 2
            ;;
    esac

    if vision_control_is_running; then
        printf '%s\n' \
            'Object acceptance refuses armed Vision Control.' \
            'Run "dogzilla stop", then start camera-only vision.' >&2
        return 1
    fi
    if perception_is_running; then
        if [[ "${mode}" != 'floor-hazards' ]]; then
            printf '%s\n' \
                'Mission perception only emits floor-region objects.' \
                'Use --floor, or test in standalone camera-only Vision.' >&2
            return 1
        fi
        service="${PERCEPTION_SERVICE_NAME}"
    elif vision_is_running; then
        service="${VISION_SERVICE_NAME}"
        set_vision_mode "${mode}" red
    else
        printf '%s\n' \
            'Camera-only Vision is not running.' \
            'Start it with "dogzilla vision objects", then retry.' >&2
        return 1
    fi

    mkdir -p "${report_directory}"
    slug="${label,,}"
    slug="${slug//-/_}"
    report_file="${report_directory}/$(
        date -u '+%Y%m%dT%H%M%SZ'
    )-${slug}.json"
    report_temporary="${report_file}.partial"
    if compose exec --no-TTY "${service}" \
        bash -lc '
            source /opt/ros/humble/setup.bash
            source /root/yahboomcar_ws/install/setup.bash
            python3 -m dogzilla_slam.object_acceptance "$@"
        ' bash \
            --label "${label}" \
            --duration "${duration}" \
            --confidence 0.55 \
            --minimum-hits 3 \
            "${floor_arguments[@]}" | tee "${report_temporary}"; then
        status=0
    else
        status=$?
    fi
    if ! python3 -c '
import json, sys
with open(sys.argv[1], encoding="utf-8") as stream:
    report = json.load(stream)
assert report.get("schema_version") == 1
assert isinstance(report.get("passed"), bool)
assert isinstance(report.get("label"), str) and report["label"]
' "${report_temporary}" 2>/dev/null; then
        rm -f -- "${report_temporary}"
        printf '%s\n' \
            'Acceptance process did not produce a valid JSON report.' >&2
        return 1
    fi
    mv -f -- "${report_temporary}" "${report_file}"
    if ((status == 0)); then
        printf 'Acceptance report saved: %s\n' "${report_file}"
        return 0
    fi
    printf 'Acceptance failed; report saved: %s\n' "${report_file}" >&2
    return 1
}

