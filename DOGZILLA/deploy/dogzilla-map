install_camera_intrinsics_file() {
    local install_source="$1"
    local install_stage

    validate_camera_intrinsics_file "${install_source}"
    if [[ -f "${CAMERA_INTRINSICS_FILE}" ]]; then
        cp --preserve=mode,timestamps \
            "${CAMERA_INTRINSICS_FILE}" \
            "${REPO_ROOT}/calibration/camera.backup.$(
                date -u '+%Y%m%dT%H%M%S%NZ'
            ).yaml"
    fi
    install_stage="$(mktemp \
        "${REPO_ROOT}/calibration/.camera.install.XXXXXX.yaml")"
    if ! install -m 0644 "${install_source}" "${install_stage}"; then
        rm -f -- "${install_stage}"
        return 1
    fi
    mv -f -- "${install_stage}" "${CAMERA_INTRINSICS_FILE}"
}

revoke_camera_calibration_display() {
    local display_number
    local revoked=false

    if [[ ! -f "${CAMERA_CALIBRATION_XHOST_STATE}" ]]; then
        return
    fi
    if ! command -v xhost >/dev/null 2>&1; then
        return 1
    fi
    for display_number in {0..9}; do
        if [[ -S "/tmp/.X11-unix/X${display_number}" ]] \
            && DISPLAY=":${display_number}" \
                xhost -SI:localuser:root >/dev/null 2>&1; then
            revoked=true
        fi
    done
    if [[ "${revoked}" == true ]]; then
        rm -f -- "${CAMERA_CALIBRATION_XHOST_STATE}"
        return
    fi
    return 1
}

reconcile_camera_calibration() {
    local calibration_container='dogzilla_camera_calibration'
    local container_role
    local pending_directory
    local pending_path

    revoke_camera_calibration_display || true
    if docker container inspect "${calibration_container}" \
        >/dev/null 2>&1; then
        container_role="$(docker container inspect \
            --format '{{index .Config.Labels "com.dogzilla.role"}}' \
            "${calibration_container}")"
        if [[ "${container_role}" != 'camera-calibration' ]]; then
            printf 'Unexpected container owns reserved name: %s\n' \
                "${calibration_container}" >&2
            return 1
        fi
        printf 'Stopping interrupted camera calibration session.\n'
        docker stop --time 20 "${calibration_container}" >/dev/null
        docker rm "${calibration_container}" >/dev/null 2>&1 || true
    fi
    if [[ ! -f "${CAMERA_CALIBRATION_STATE}" ]]; then
        return
    fi
    IFS= read -r pending_directory < "${CAMERA_CALIBRATION_STATE}"
    if [[ "$(dirname -- "${pending_directory}")" \
            != "${REPO_ROOT}/calibration" \
        || ! "$(basename -- "${pending_directory}")" \
            =~ ^\.camera-calibration\.[A-Za-z0-9]+$ ]]; then
        printf 'Unsafe camera-calibration state path; refusing cleanup: %s\n' \
            "${pending_directory}" >&2
        return 1
    fi
    pending_path="${pending_directory}/camera.yaml"
    if [[ -f "${pending_path}" ]]; then
        if validate_camera_intrinsics_file "${pending_path}"; then
            install_camera_intrinsics_file "${pending_path}"
            printf 'Recovered committed camera intrinsics after interruption.\n'
        else
            printf 'Discarding invalid interrupted calibration result.\n' >&2
        fi
    fi
    rm -f -- "${pending_path}"
    rmdir -- "${pending_directory}" 2>/dev/null || true
    rm -f -- "${CAMERA_CALIBRATION_STATE}"
}

calibrate_camera_intrinsics() {
    local board_columns
    local board_rows
    local board_size="${1:-}"
    local calibration_container='dogzilla_camera_calibration'
    local calibration_status
    local cleanup_directory=''
    local display_access=false
    local pending_name
    local pending_path=''
    local square_size="${2:-}"

    if (($# != 2)); then
        printf '%s\n' \
            'Usage: dogzilla camera-calibrate BOARD_SIZE SQUARE_METRES' \
            'Example: dogzilla camera-calibrate 8x6 0.025' >&2
        return 2
    fi
    if [[ ! "${board_size}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
        printf 'BOARD_SIZE must look like 8x6 and count inner corners.\n' >&2
        return 2
    fi
    board_columns="${BASH_REMATCH[1]}"
    board_rows="${BASH_REMATCH[2]}"
    if ((board_columns < 3 || board_columns > 30 \
        || board_rows < 3 || board_rows > 30)); then
        printf 'Each BOARD_SIZE dimension must be between 3 and 30.\n' >&2
        return 2
    fi
    if ! python3 -c '
import math, sys
value = float(sys.argv[1])
raise SystemExit(0 if math.isfinite(value) and 0.001 <= value <= 0.5 else 1)
' "${square_size}" 2>/dev/null; then
        printf 'SQUARE_METRES must be between 0.001 and 0.5 metres.\n' >&2
        return 2
    fi
    reconcile_camera_calibration
    if container_is_running || drive_is_running || navigation_is_running \
        || shadow_is_running; then
        printf 'Stop the active DOGZILLA mode before camera calibration.\n' >&2
        printf 'Run "dogzilla stop" first.\n' >&2
        return 1
    fi
    if [[ ! -c /dev/video0 ]]; then
        printf 'Camera device is missing: /dev/video0\n' >&2
        return 1
    fi
    ensure_runtime_directories
    ensure_image
    select_local_display
    require_command xhost
    stop_vendor_application
    assert_camera_free

    cleanup_directory="$(mktemp -d \
        "${REPO_ROOT}/calibration/.camera-calibration.XXXXXX")"
    pending_path="${cleanup_directory}/camera.yaml"
    pending_name="${cleanup_directory##*/}/camera.yaml"
    printf '%s\n' "${cleanup_directory}" \
        > "${CAMERA_CALIBRATION_STATE}.tmp"
    mv -f -- \
        "${CAMERA_CALIBRATION_STATE}.tmp" \
        "${CAMERA_CALIBRATION_STATE}"

    cleanup_camera_calibration() {
        docker stop --time 20 "${calibration_container}" \
            >/dev/null 2>&1 || true
        if [[ "${display_access}" == true ]]; then
            if xhost -SI:localuser:root >/dev/null 2>&1; then
                rm -f -- "${CAMERA_CALIBRATION_XHOST_STATE}"
            fi
        fi
        if [[ -n "${pending_path}" ]]; then
            rm -f -- "${pending_path}"
        fi
        if [[ -n "${cleanup_directory}" ]]; then
            rmdir -- "${cleanup_directory}" 2>/dev/null || true
        fi
        rm -f -- \
            "${CAMERA_CALIBRATION_STATE}" \
            "${CAMERA_CALIBRATION_STATE}.tmp"
    }
    trap cleanup_camera_calibration EXIT INT TERM

    xhost +SI:localuser:root >/dev/null
    : > "${CAMERA_CALIBRATION_XHOST_STATE}"
    display_access=true
    printf '%s\n' \
        'Camera calibration opens on the Raspberry Pi monitor.' \
        'Keep DOGZILLA stationary; move only the checkerboard.' \
        'Fill all four coverage bars, click CALIBRATE, inspect the result,' \
        'then click COMMIT. Closing the window without COMMIT changes nothing.'

    set +e
    docker run \
        --rm \
        --interactive \
        --name "${calibration_container}" \
        --init \
        --stop-signal SIGINT \
        --label com.dogzilla.role=camera-calibration \
        --network none \
        --device /dev/video0:/dev/video0 \
        --env DISPLAY="${DISPLAY}" \
        --env QT_X11_NO_MITSHM=1 \
        --env ROS_DOMAIN_ID=115 \
        --env ROS_LOCALHOST_ONLY=1 \
        --env ROS_LOG_DIR=/tmp/ros-logs \
        --volume /tmp/.X11-unix:/tmp/.X11-unix:rw \
        --volume "${REPO_ROOT}/calibration:/calibration:rw" \
        "${IMAGE_NAME}" \
        timeout --signal=INT --kill-after=30s 1800s \
        ros2 launch dogzilla_slam camera_calibration.launch.py \
            enabled:=true \
            board_size:="${board_size}" \
            square_size:="${square_size}" \
            camera_info_url:="file:///calibration/${pending_name}"
    calibration_status=$?
    set -e

    if ((calibration_status != 0)); then
        printf 'Camera calibration exited with status %d; nothing installed.\n' \
            "${calibration_status}" >&2
        cleanup_camera_calibration
        trap - EXIT INT TERM
        unset -f cleanup_camera_calibration
        return "${calibration_status}"
    fi
    if [[ ! -f "${pending_path}" ]]; then
        printf 'No committed calibration was received; camera.yaml is unchanged.\n' \
            >&2
        cleanup_camera_calibration
        trap - EXIT INT TERM
        unset -f cleanup_camera_calibration
        return 1
    fi
    if ! validate_camera_intrinsics_file "${pending_path}"; then
        printf 'Committed calibration failed validation; camera.yaml is unchanged.\n' \
            >&2
        cleanup_camera_calibration
        trap - EXIT INT TERM
        unset -f cleanup_camera_calibration
        return 1
    fi

    install_camera_intrinsics_file "${pending_path}"
    printf 'Validated camera intrinsics installed: %s\n' \
        "${CAMERA_INTRINSICS_FILE}"

    cleanup_camera_calibration
    trap - EXIT INT TERM
    unset -f cleanup_camera_calibration
}

set_camera_extrinsics() {
    local backup_path
    local pending_path

    if (($# != 7)) || [[ "${1:-}" != '--measured' ]]; then
        printf '%s\n' \
            'Usage: dogzilla camera-extrinsics --measured X Y Z ROLL PITCH YAW' \
            'XYZ is metres; roll, pitch, and yaw are degrees.' >&2
        return 2
    fi
    ensure_runtime_directories
    pending_path="$(mktemp \
        "${REPO_ROOT}/calibration/.camera-extrinsics.XXXXXX.yaml")"
    if ! python3 "${CAMERA_MODEL_HELPER}" \
        --write-extrinsics "${pending_path}" \
        --translation "${2}" "${3}" "${4}" \
        --rotation-degrees "${5}" "${6}" "${7}" \
        --confirm-measured; then
        rm -f -- "${pending_path}"
        return 1
    fi
    if [[ -f "${CAMERA_EXTRINSICS_FILE}" ]]; then
        backup_path="${REPO_ROOT}/calibration/camera_extrinsics.backup.$(
            date -u '+%Y%m%dT%H%M%SZ'
        ).yaml"
        cp --preserve=mode,timestamps \
            "${CAMERA_EXTRINSICS_FILE}" "${backup_path}"
        printf 'Previous extrinsics backed up: %s\n' "${backup_path}"
    fi
    mv -f -- "${pending_path}" "${CAMERA_EXTRINSICS_FILE}"
    printf 'Measured camera extrinsics installed: %s\n' \
        "${CAMERA_EXTRINSICS_FILE}"
}

check_camera() {
    local camera_container='dogzilla_camera_check'
    local cleanup_status=0
    local duration="${1:-8}"
    local validation_status=0
    reconcile_camera_calibration
    if [[ ! "${duration}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        printf 'SECONDS must be a positive number.\n' >&2
        exit 1
    fi
    if [[ ! -c /dev/video0 ]]; then
        printf 'Camera device is missing: /dev/video0\n' >&2
        exit 1
    fi
    if shadow_is_running || vision_device_is_running; then
        printf 'A DOGZILLA camera service already owns /dev/video0.\n' >&2
        exit 1
    fi
    ensure_image
    stop_vendor_application
    assert_camera_free

    if docker container inspect "${camera_container}" >/dev/null 2>&1; then
        printf 'Temporary camera container already exists: %s\n' \
            "${camera_container}" >&2
        printf 'Stop it before retrying camera-check.\n' >&2
        return 1
    fi
    if ! docker run \
        --rm \
        --detach \
        --name "${camera_container}" \
        --init \
        --stop-signal SIGINT \
        --network host \
        --device /dev/video0:/dev/video0 \
        --env ROS_DOMAIN_ID=113 \
        "${IMAGE_NAME}" \
        ros2 launch dogzilla_slam mono_camera.launch.py \
            enabled:=true rectify:=false \
            camera_info_url:=file:///tmp/dogzilla-uncalibrated.yaml \
            >/dev/null; then
        return 1
    fi

    trap 'docker stop --time 20 dogzilla_camera_check >/dev/null 2>&1 || true' \
        EXIT INT TERM
    set +e
    docker exec "${camera_container}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        timeout 12 bash -c '\''
            until ros2 topic list --no-daemon --spin-time 2 \
                    | grep -qx /camera/image_raw; do
                sleep 0.5
            done
        '\''
    '
    validation_status=$?
    if ((validation_status == 0)); then
        docker exec "${camera_container}" bash -lc '
            source /opt/ros/humble/setup.bash
            source /root/yahboomcar_ws/install/setup.bash
            exec ros2 run dogzilla_slam camera_validate --duration "$1"
        ' _ "${duration}"
        validation_status=$?
    fi
    docker stop --time 20 "${camera_container}" >/dev/null
    cleanup_status=$?
    set -e
    trap - EXIT INT TERM

    if ((cleanup_status != 0)); then
        printf 'Camera validation container did not stop cleanly.\n' >&2
        return 1
    fi
    return "${validation_status}"
}

check_shadow() {
    local duration="${1:-10}"
    if [[ ! "${duration}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        printf 'SECONDS must be a positive number.\n' >&2
        exit 1
    fi
    if ! shadow_is_running || ! container_is_running; then
        printf 'Visual shadow mapping is not running.\n' >&2
        exit 1
    fi
    compose exec --no-TTY "${SHADOW_SERVICE_NAME}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        set -e
        ros2 run dogzilla_slam camera_validate \
            --image-topic /camera/image_rect \
            --duration "$1" \
            --require-calibration \
            --intrinsics /calibration/camera.yaml \
            --report-json "$ROS_LOG_DIR/shadow-camera-report.json"
        ros2 node list --no-daemon --spin-time 2 \
            | grep -qx /rtabmap_shadow/rtabmap_mono
        ros2 run dogzilla_slam shadow_validate \
            --duration "$1" \
            --report-json "$ROS_LOG_DIR/shadow-health-report.json"
    ' _ "${duration}"
}

check_shadow_route() {
    local duration="${1:-120}"
    local minimum_travel="${2:-1.0}"
    if [[ ! "${duration}" =~ ^[0-9]+([.][0-9]+)?$ \
        || ! "${minimum_travel}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        printf 'SECONDS and MIN_METRES must be positive numbers.\n' >&2
        exit 1
    fi
    if ! shadow_is_running || ! container_is_running; then
        printf 'Visual shadow mapping is not running.\n' >&2
        exit 1
    fi
    printf '%s\n' \
        'Route check is read-only and will not move the robot.' \
        'Drive a loop, revisit the starting view, then stop near the start.'
    compose exec --no-TTY "${SHADOW_SERVICE_NAME}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        set -e
        ros2 run dogzilla_slam camera_validate \
            --image-topic /camera/image_rect \
            --duration 5 \
            --require-calibration \
            --intrinsics /calibration/camera.yaml \
            --report-json "$ROS_LOG_DIR/route-camera-report.json"
        printf "Camera gate passed. Begin the route now.\n"
        ros2 run dogzilla_slam shadow_validate \
            --duration "$1" \
            --require-loop-closure \
            --minimum-travel-metres "$2" \
            --maximum-return-metres 0.75 \
            --report-json "$ROS_LOG_DIR/shadow-route-report.json"
    ' _ "${duration}" "${minimum_travel}"
}

check_shadow_database() {
    local session_name="${1:-latest}"
    local session_directory
    local database_path
    local report_path

    if shadow_is_running; then
        printf 'Stop visual shadow mode before checking its database.\n' >&2
        printf 'Run "dogzilla stop" first.\n' >&2
        exit 1
    fi
    if [[ "${session_name}" == latest ]]; then
        session_directory="${REPO_ROOT}/logs/latest"
    elif [[ "${session_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
        session_directory="${REPO_ROOT}/logs/sessions/${session_name}"
    else
        printf 'SESSION may contain only letters, numbers, dot, dash, and underscore.\n' >&2
        exit 1
    fi
    database_path="${session_directory}/rtabmap_mono_shadow.db"
    report_path="${session_directory}/shadow-database-report.json"
    require_command python3
    PYTHONPATH="${DATABASE_VALIDATE_PACKAGE}${PYTHONPATH:+:${PYTHONPATH}}" \
        python3 -m dogzilla_slam.database_validate \
            --database "${database_path}" \
            --expected-version 0.23.7 \
            --minimum-nodes 1 \
            --report-json "${report_path}"
}

start_drive() {
    assert_mission_allows_start
    ensure_runtime_directories
    ensure_image
    if container_is_running || navigation_is_running || shadow_is_running \
        || vision_device_is_running; then
        printf 'Mapping/localization is running. Stop it before drive mode.\n' >&2
        printf 'Run "dogzilla stop" first.\n' >&2
        exit 1
    fi
    stop_vendor_application

    if drive_is_running; then
        compose stop --timeout 10 "${DRIVE_SERVICE_NAME}"
    fi

    pause_oled_service
    if ! assert_serial_ports_free /dev/ttyAMA0; then
        restore_oled_service
        return 1
    fi
    begin_log_session

    if ! compose up \
        --detach \
        --no-build \
        --force-recreate \
        "${DRIVE_SERVICE_NAME}"; then
        restore_oled_service
        return 1
    fi

    printf 'DOGZILLA controller-only mode started.\n'
    printf 'LiDAR, Cartographer, map generation, and RViz are not running.\n'
    printf 'ROS log session: logs/sessions/%s (logs/latest).\n' \
        "${DOGZILLA_LOG_SESSION}"
    printf 'Run "dogzilla teleop" to drive.\n'
}

configure_navigation_options() {
    local mode="$1"
    local map_name='test1'
    shift

    if (($# > 0)) && [[ "$1" != --* ]]; then
        map_name="$1"
        shift
    fi
    if [[ ! "${map_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
        printf 'Map name may contain only letters, numbers, dot, underscore, and dash.\n' >&2
        exit 1
    fi
    for map_path in \
        "${REPO_ROOT}/maps/${map_name}.pbstream" \
        "${REPO_ROOT}/maps/${map_name}.yaml" \
        "${REPO_ROOT}/maps/${map_name}.pgm"; do
        if [[ ! -s "${map_path}" ]]; then
            printf 'Required localization map file is missing: %s\n' \
                "${map_path}" >&2
            exit 1
        fi
    done

    configure_start_options "$@"
    if [[ "${DOGZILLA_USE_IMU}" == 'true' ]]; then
        require_valid_imu_calibration
        DOGZILLA_CONFIGURATION_BASENAME='dogzilla_localization_imu.lua'
    else
        DOGZILLA_CONFIGURATION_BASENAME='dogzilla_localization.lua'
    fi

    DOGZILLA_MAP_NAME="${map_name}"
    DOGZILLA_MAP_YAML="/maps/${map_name}.yaml"
    DOGZILLA_STATE_FILE="/maps/${map_name}.pbstream"
    if [[ "${mode}" == 'navigate' ]]; then
        DOGZILLA_USE_NAV2=true
    else
        DOGZILLA_USE_NAV2=false
    fi
    export \
        DOGZILLA_CONFIGURATION_BASENAME \
        DOGZILLA_MAP_NAME \
        DOGZILLA_MAP_YAML \
        DOGZILLA_STATE_FILE \
        DOGZILLA_USE_NAV2
}

start_navigation() {
    local mode="$1"
    shift

    assert_mission_allows_start
    ensure_runtime_directories
    ensure_image
    if container_is_running || drive_is_running || shadow_is_running \
        || vision_device_is_running; then
        printf 'Mapping or drive mode is running. Stop it first.\n' >&2
        printf 'Run "dogzilla stop" first.\n' >&2
        exit 1
    fi
    configure_navigation_options "${mode}" "$@"
    stop_vendor_application

    if navigation_is_running; then
        compose stop --timeout 20 "${NAVIGATION_SERVICE_NAME}"
    fi

    pause_oled_service
    if ! assert_serial_ports_free; then
        restore_oled_service
        return 1
    fi
    if ! enable_display_access; then
        restore_oled_service
        return 1
    fi
    begin_log_session

    if ! compose up \
        --detach \
        --no-build \
        --force-recreate \
        "${NAVIGATION_SERVICE_NAME}"; then
        restore_oled_service
        return 1
    fi

    if [[ "${mode}" == 'navigate' ]]; then
        printf 'DOGZILLA localization + Nav2 started on map %s.\n' \
            "${DOGZILLA_MAP_NAME}"
        printf 'Autonomous limits: 0.10 m/s linear, 0.30 rad/s angular.\n'
    else
        printf 'DOGZILLA pure localization started on map %s.\n' \
            "${DOGZILLA_MAP_NAME}"
        printf 'Nav2 path planning is not running in this mode.\n'
    fi
    printf 'Unknown/unmapped map cells remain non-traversable.\n'
    printf 'ROS log session: logs/sessions/%s (logs/latest).\n' \
        "${DOGZILLA_LOG_SESSION}"
    printf 'Use status, then RViz 2D Pose Estimate before sending a goal.\n'
}

run_imu_calibration() {
    local calibration_status

    if container_is_running || drive_is_running || navigation_is_running \
        || shadow_is_running || vision_device_is_running; then
        printf 'Stop every DOGZILLA mode before IMU calibration.\n' >&2
        printf 'Run "dogzilla stop" first.\n' >&2
        exit 1
    fi

    ensure_image
    pause_oled_service
    if ! assert_serial_ports_free /dev/ttyAMA0; then
        restore_oled_service
        return 1
    fi

    set +e
    docker run \
        --rm \
        --interactive \
        --tty \
        --device /dev/ttyAMA0:/dev/ttyAMA0 \
        --volume "${REPO_ROOT}/calibration:/calibration" \
        "${IMAGE_NAME}" \
        ros2 run dogzilla_slam imu_calibrate \
        --output /calibration/imu.json \
        --owner-uid "$(id -u)" \
        --owner-gid "$(id -g)"
    calibration_status=$?
