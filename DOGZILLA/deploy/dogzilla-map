require_command() {
    local command_name="$1"
    if ! command -v "${command_name}" >/dev/null 2>&1; then
        printf 'Required command not found: %s\n' "${command_name}" >&2
        exit 1
    fi
}

ensure_runtime_directories() {
    mkdir -p \
        "${REPO_ROOT}/maps" \
        "${REPO_ROOT}/logs/sessions" \
        "${REPO_ROOT}/calibration" \
        "${REPO_ROOT}/datasets" \
        "${REPO_ROOT}/profiles/captures" \
        "${REPO_ROOT}/profiles/validated" \
        "${OBJECT_MODEL_DIR}"
}

assert_mission_allows_start() {
    if [[ -f "${MISSION_STATE_FILE}" \
        && "${DOGZILLA_MISSION_START:-0}" != 1 ]]; then
        printf 'A managed Mission Mode session is still recorded.\n' >&2
        printf 'Run "dogzilla mission stop" before starting another mode.\n' >&2
        exit 1
    fi
}

container_is_running() {
    service_is_running "${SERVICE_NAME}"
}

drive_is_running() {
    service_is_running "${DRIVE_SERVICE_NAME}"
}

navigation_is_running() {
    service_is_running "${NAVIGATION_SERVICE_NAME}"
}

shadow_is_running() {
    service_is_running "${SHADOW_SERVICE_NAME}"
}

vision_is_running() {
    service_is_running "${VISION_SERVICE_NAME}"
}

vision_control_is_running() {
    service_is_running "${VISION_CONTROL_SERVICE_NAME}"
}

perception_is_running() {
    service_is_running "${PERCEPTION_SERVICE_NAME}"
}

vision_device_is_running() {
    vision_is_running || vision_control_is_running || perception_is_running
}

service_is_running() {
    local service_name="$1"
    compose ps --status running --services 2>/dev/null \
        | grep -qx "${service_name}"
}

active_control_service() {
    if container_is_running; then
        printf '%s\n' "${SERVICE_NAME}"
    elif drive_is_running; then
        printf '%s\n' "${DRIVE_SERVICE_NAME}"
    elif navigation_is_running; then
        printf '%s\n' "${NAVIGATION_SERVICE_NAME}"
    elif vision_control_is_running; then
        printf '%s\n' "${VISION_CONTROL_SERVICE_NAME}"
    else
        return 1
    fi
}

require_running_container() {
    if ! container_is_running; then
        printf 'DOGZILLA mapping is not running. Start it first.\n' >&2
        exit 1
    fi
}

active_lidar_service() {
    if container_is_running; then
        printf '%s\n' "${SERVICE_NAME}"
    elif navigation_is_running; then
        printf '%s\n' "${NAVIGATION_SERVICE_NAME}"
    else
        return 1
    fi
}

free_disk_kb() {
    df -Pk "${REPO_ROOT}" | awk 'NR == 2 {print $4}'
}

base_image_id() {
    docker image inspect --format '{{.Id}}' "${BASE_IMAGE_NAME}" 2>/dev/null
}

verify_base_image() {
    local actual_image_id

    if ! actual_image_id="$(base_image_id)"; then
        printf 'Downloading the expected Yahboom 3.8 base image.\n'
        docker pull "${BASE_IMAGE_NAME}"
        actual_image_id="$(base_image_id)"
    fi

    if [[ "${actual_image_id}" != "${EXPECTED_BASE_IMAGE_ID}" ]]; then
        printf 'Yahboom base-image mismatch.\n' >&2
        printf 'Expected: %s\n' "${EXPECTED_BASE_IMAGE_ID}" >&2
        printf 'Found:    %s\n' "${actual_image_id}" >&2
        printf 'The mutable 3.8 tag changed; review it before updating the pin.\n' >&2
        exit 1
    fi

    docker image tag "${BASE_IMAGE_NAME}" "${PINNED_BASE_ALIAS}"
}

run_doctor() {
    local failure=0
    local available_kb
    local actual_image_id

    require_command docker
    printf 'Docker: '
    docker --version
    printf 'Compose: '
    docker compose version

    if actual_image_id="$(base_image_id)"; then
        if [[ "${actual_image_id}" == "${EXPECTED_BASE_IMAGE_ID}" ]]; then
            printf 'Yahboom base image: verified %s\n' "${actual_image_id}"
        else
            printf 'Yahboom base image: unexpected %s\n' \
                "${actual_image_id}" >&2
            failure=1
        fi
    else
        printf 'Yahboom base image: not downloaded (build will download it).\n'
    fi

    for device_path in /dev/ttyAMA0 /dev/ttyAMA1; do
        if [[ -c "${device_path}" ]]; then
            printf 'Device OK: %s\n' "${device_path}"
        else
            printf 'Device missing: %s\n' "${device_path}" >&2
            failure=1
        fi
    done

    available_kb="$(free_disk_kb)"
    printf 'Free disk: %d MiB\n' "$((available_kb / 1024))"
    if ((available_kb < MINIMUM_BUILD_KB)); then
        printf 'Build warning: at least 2560 MiB free is recommended.\n' >&2
    fi

    if [[ -n "${DISPLAY:-}" ]]; then
        printf 'Desktop display: %s\n' "${DISPLAY}"
    else
        printf 'Desktop display: unavailable in this terminal (headless mode works).\n'
    fi

    return "${failure}"
}

build_image() {
    local available_kb
    ensure_runtime_directories
    available_kb="$(free_disk_kb)"

    if ((available_kb < MINIMUM_BUILD_KB)) \
        && [[ "${DOGZILLA_ALLOW_LOW_DISK:-0}" != '1' ]]; then
        printf 'Build refused: only %d MiB is free; 2560 MiB is required.\n' \
            "$((available_kb / 1024))" >&2
        printf 'Free or expand storage, then run the build again.\n' >&2
        printf 'Override only at your own risk with DOGZILLA_ALLOW_LOW_DISK=1.\n' >&2
        exit 1
    fi

    verify_base_image
    DOGZILLA_BASE_IMAGE="${PINNED_BASE_ALIAS}" compose build "${SERVICE_NAME}"
}

ensure_image() {
    if ! docker image inspect "${IMAGE_NAME}" >/dev/null 2>&1; then
        printf 'The reproducible image does not exist yet; building it now.\n'
        build_image
    fi
}

stop_vendor_application() {
    local any_alive
    local attempt
    local owner_pid
    local vendor_path="${REPO_ROOT}/app_dogzilla/app_dogzilla.py"
    local vendor_pids=()

    mapfile -t vendor_pids < <(
        pgrep -f "^python3 ${vendor_path//./\\.}([[:space:]]|$)" || true
    )
    if ((${#vendor_pids[@]} == 0)); then
        return
    fi

    printf 'Stopping the Yahboom application through its Ctrl-C cleanup path.\n'
    kill -INT "${vendor_pids[@]}"
    for attempt in {1..50}; do
        any_alive=false
        for owner_pid in "${vendor_pids[@]}"; do
            if kill -0 "${owner_pid}" 2>/dev/null; then
                any_alive=true
            fi
        done
        if [[ "${any_alive}" == false ]]; then
            return
        fi
        sleep 0.1
    done
    printf '%s\n' \
        'Yahboom application did not stop after Ctrl-C.' \
        'Refusing to use kill -9; close it manually and retry.' >&2
    return 1
}

assert_camera_free() {
    local command_name
    local owner_pid
    local unexpected_owners=()

    if ! command -v fuser >/dev/null 2>&1; then
        return
    fi
    for owner_pid in $(fuser /dev/video0 2>/dev/null || true); do
        command_name="$(ps -p "${owner_pid}" -o comm= 2>/dev/null || true)"
        case "${command_name}" in
            pipewire|wireplumber)
                ;;
            *)
                unexpected_owners+=("${owner_pid}:${command_name:-unknown}")
                ;;
        esac
    done
    if ((${#unexpected_owners[@]} > 0)); then
        printf 'Camera device is already in use: /dev/video0\n' >&2
        printf 'Owners: %s\n' "${unexpected_owners[*]}" >&2
        printf 'Close the other camera program and retry.\n' >&2
        return 1
    fi
}

pause_oled_service() {
    if ! command -v systemctl >/dev/null 2>&1; then
        return
    fi
    if systemctl is-active --quiet "${OLED_SERVICE}"; then
        printf 'Pausing %s while DOGZILLA ROS owns /dev/ttyAMA0.\n' \
            "${OLED_SERVICE}"
        sudo systemctl stop "${OLED_SERVICE}"
        : > "${OLED_STATE_FILE}"
    fi
}

restore_oled_service() {
    if [[ ! -f "${OLED_STATE_FILE}" ]]; then
        return
    fi

    printf 'Restoring %s.\n' "${OLED_SERVICE}"
    sudo systemctl start "${OLED_SERVICE}"
    rm -f "${OLED_STATE_FILE}"
}

send_lidar_off() {
    local helper_path="${REPO_ROOT}/ros2/dogzilla_slam/dogzilla_slam/lidar_off.py"

    assert_serial_ports_free /dev/ttyAMA1
    verify_base_image
    docker run \
        --rm \
        --device /dev/ttyAMA1:/dev/ttyAMA1 \
        --volume "${helper_path}:/opt/dogzilla/lidar_off.py:ro" \
        "${PINNED_BASE_ALIAS}" \
        python3 /opt/dogzilla/lidar_off.py /dev/ttyAMA1
}

confirm_servo_mode() {
    local confirmation
    local mode="$1"

    if [[ "${mode}" == 'rest' ]]; then
        printf '%s\n' \
            'SAFETY: REST is disabled.' \
            'Public action 1 is not verified as the firmware low-battery/power-button trajectory.' \
            'No movement or torque command will be sent until a real profile is captured and validated.' >&2
        return 1
    fi

    printf '%s\n' \
        'WARNING: STAND plays Yahboom animated stand-up action 2.' \
        'Support DOGZILLA on a clear, level floor and keep hands clear of joints.'
    printf 'Type STAND to confirm: '
    read -r confirmation
    [[ "${confirmation}" == 'STAND' ]]
}

run_servo_mode() {
    local command_status
    local mode="$1"

    if container_is_running || drive_is_running || navigation_is_running \
        || shadow_is_running || vision_device_is_running; then
        printf 'Stop mapping, localization, or drive mode before using %s.\n' \
            "${mode}" >&2
        printf 'Run "dogzilla stop" first.\n' >&2
        exit 1
    fi

    ensure_image
    if ! confirm_servo_mode "${mode}"; then
        printf 'Cancelled; no servo command was sent.\n'
        return 1
    fi

    stop_vendor_application
    pause_oled_service
    if ! assert_serial_ports_free /dev/ttyAMA0; then
        restore_oled_service
        return 1
    fi

    set +e
    docker run \
        --rm \
        --interactive \
        --device /dev/ttyAMA0:/dev/ttyAMA0 \
        "${IMAGE_NAME}" \
        ros2 run dogzilla_slam servo_power "${mode}"
    command_status=$?
    set -e

    restore_oled_service
    return "${command_status}"
}

run_firmware_rest_capture() {
    local command_status
    local confirmation

    if container_is_running || drive_is_running || navigation_is_running \
        || shadow_is_running || vision_device_is_running; then
        printf 'Stop mapping, localization, navigation, or drive mode first.\n' >&2
        printf 'Run "dogzilla stop" first.\n' >&2
        exit 1
    fi

    ensure_runtime_directories
    ensure_image
    printf '%s\n' \
        'READ-ONLY: this captures the controller low-battery trajectory.' \
        'It sends battery and joint read requests only; it never commands motion or torque.' \
        'Start only while DOGZILLA is stationary on a clear, level floor.' \
        'Do not press the physical power button; allow low battery to occur naturally.'
    printf 'Type CAPTURE to continue: '
    read -r confirmation
    if [[ "${confirmation}" != 'CAPTURE' ]]; then
        printf 'Cancelled; the serial port was not opened.\n'
        return 1
    fi

    stop_vendor_application
    pause_oled_service
    if ! assert_serial_ports_free /dev/ttyAMA0; then
        restore_oled_service
        return 1
    fi

    set +e
    docker run \
        --rm \
        --interactive \
        --device /dev/ttyAMA0:/dev/ttyAMA0 \
        --volume "${REPO_ROOT}/profiles:/profiles" \
        "${IMAGE_NAME}" \
        ros2 run dogzilla_slam firmware_rest_monitor
    command_status=$?
    set -e

    restore_oled_service
    return "${command_status}"
}

assert_serial_ports_free() {
    local device_path
    local device_paths=("$@")

    if ! command -v fuser >/dev/null 2>&1; then
        return
    fi

    if ((${#device_paths[@]} == 0)); then
        device_paths=(/dev/ttyAMA0 /dev/ttyAMA1)
    fi

    for device_path in "${device_paths[@]}"; do
        if fuser "${device_path}" >/dev/null 2>&1; then
            printf 'Serial device is already in use: %s\n' "${device_path}" >&2
            printf 'Stop the other DOGZILLA program or ROS launch first.\n' >&2
            return 1
        fi
    done
}

configure_start_options() {
    local display_mode='auto'
    local option
    DOGZILLA_USE_IMU=false
    DOGZILLA_CONFIGURATION_BASENAME='dogzilla_2d.lua'

    for option in "$@"; do
        case "${option}" in
            --rviz)
                display_mode='rviz'
                ;;
            --headless)
                display_mode='headless'
                ;;
            --imu)
                DOGZILLA_USE_IMU=true
                DOGZILLA_CONFIGURATION_BASENAME='dogzilla_2d_imu.lua'
                ;;
            *)
                printf 'Unknown start option: %s\n' "${option}" >&2
                usage
                exit 1
                ;;
        esac
    done

    if [[ "${display_mode}" == 'rviz' ]]; then
        if [[ -z "${DISPLAY:-}" ]]; then
            printf 'RViz requested, but this terminal has no DISPLAY.\n' >&2
            printf 'Run start --rviz from the terminal on the Pi monitor.\n' >&2
            exit 1
        fi
        DOGZILLA_RVIZ=true
    elif [[ "${display_mode}" == 'headless' ]]; then
        DOGZILLA_RVIZ=false
    elif [[ -n "${DISPLAY:-}" ]]; then
        DOGZILLA_RVIZ=true
    else
        DOGZILLA_RVIZ=false
    fi

    DOGZILLA_DISPLAY="${DISPLAY:-}"
    export \
        DOGZILLA_CONFIGURATION_BASENAME \
        DOGZILLA_DISPLAY \
        DOGZILLA_RVIZ \
        DOGZILLA_USE_IMU
}

require_valid_imu_calibration() {
    if [[ ! -f "${CALIBRATION_FILE}" ]]; then
        printf 'IMU fusion requires %s.\n' "${CALIBRATION_FILE}" >&2
        printf 'Run "dogzilla imu-calibrate" first.\n' >&2
        exit 1
    fi

    if ! python3 -c '
import json, sys
with open(sys.argv[1], encoding="utf-8") as stream:
    calibration = json.load(stream)
if calibration.get("schema_version") != 1:
    raise SystemExit("Unsupported IMU calibration schema")
if calibration.get("axis_validated") is not True:
    raise SystemExit("IMU axis validation is incomplete")
' "${CALIBRATION_FILE}"; then
        printf 'IMU calibration is invalid; repeat the guided calibration.\n' >&2
        exit 1
    fi
}

require_valid_camera_model() {
    local pose

    if ! pose="$(python3 "${CAMERA_MODEL_HELPER}" \
        --intrinsics "${CAMERA_INTRINSICS_FILE}" \
        --extrinsics "${CAMERA_EXTRINSICS_FILE}" \
        --print-pose)"; then
        printf '%s\n' \
            'Visual shadow mode was not started.' \
            'Create camera.yaml with ROS camera_calibration at 640x480,' \
            'then measure calibration/camera_extrinsics.yaml.' >&2
        return 1
    fi

    read -r \
        DOGZILLA_CAMERA_X \
        DOGZILLA_CAMERA_Y \
        DOGZILLA_CAMERA_Z \
        DOGZILLA_CAMERA_ROLL \
        DOGZILLA_CAMERA_PITCH \
        DOGZILLA_CAMERA_YAW <<< "${pose}"
    export \
        DOGZILLA_CAMERA_X \
        DOGZILLA_CAMERA_Y \
        DOGZILLA_CAMERA_Z \
        DOGZILLA_CAMERA_ROLL \
        DOGZILLA_CAMERA_PITCH \
        DOGZILLA_CAMERA_YAW
}

begin_log_session() {
    local base_name
    local candidate
    local suffix=1

    base_name="$(date -u '+%Y%m%dT%H%M%SZ')"
    candidate="${base_name}"
    while [[ -e "${REPO_ROOT}/logs/sessions/${candidate}" ]]; do
        suffix=$((suffix + 1))
        candidate="${base_name}-${suffix}"
    done

    mkdir -p "${REPO_ROOT}/logs/sessions/${candidate}"
    ln -sfn "sessions/${candidate}" "${REPO_ROOT}/logs/latest"
    printf '%s\n' "${candidate}" > "${REPO_ROOT}/logs/current-session"
    DOGZILLA_ROS_LOG_DIR="/logs/sessions/${candidate}"
    DOGZILLA_LOG_SESSION="${candidate}"
    export DOGZILLA_LOG_SESSION DOGZILLA_ROS_LOG_DIR
}

enable_display_access() {
    if [[ "${DOGZILLA_RVIZ}" != 'true' ]]; then
        return
    fi
    require_command xhost
    xhost +SI:localuser:root >/dev/null
}

start_mapping() {
    assert_mission_allows_start
    ensure_runtime_directories
    ensure_image
    if drive_is_running || navigation_is_running || shadow_is_running \
        || vision_device_is_running; then
        printf 'Another DOGZILLA mode is running. Stop it before mapping.\n' >&2
        printf 'Run "dogzilla stop" first.\n' >&2
        exit 1
    fi
    configure_start_options "$@"
    if [[ "${DOGZILLA_USE_IMU}" == 'true' ]]; then
        require_valid_imu_calibration
    fi
    stop_vendor_application

    if container_is_running; then
        compose stop --timeout 20 "${SERVICE_NAME}"
    fi

    pause_oled_service
    if ! assert_serial_ports_free; then
        restore_oled_service
        return 1
    fi
    if ! enable_display_access; then
        restore_oled_service
        return 1
    fi
    begin_log_session

    if ! compose up \
        --detach \
        --no-build \
        --force-recreate \
        "${SERVICE_NAME}"; then
        restore_oled_service
        return 1
    fi

    printf 'DOGZILLA mapping started.\n'
    if [[ "${DOGZILLA_USE_IMU}" == 'true' ]]; then
        printf 'Fusion profile: calibrated IMU + LiDAR scan matching.\n'
    else
        printf 'Fusion profile: LiDAR-only (use --imu after calibration).\n'
    fi
    printf 'ROS log session: logs/sessions/%s (logs/latest).\n' \
        "${DOGZILLA_LOG_SESSION}"
    printf 'Use "dogzilla status" to check /scan and /map.\n'
    printf 'Use "dogzilla logs" to watch Cartographer.\n'
}

start_visual_shadow() {
    reconcile_camera_calibration
    if container_is_running || drive_is_running || navigation_is_running \
        || shadow_is_running || vision_device_is_running; then
        printf 'Another DOGZILLA mode is running. Stop it before shadow mode.\n' >&2
        printf 'Run "dogzilla stop" first.\n' >&2
        exit 1
    fi
    if [[ ! -c /dev/video0 ]]; then
        printf 'Camera device is missing: /dev/video0\n' >&2
        exit 1
    fi
    require_valid_camera_model
    start_mapping "$@"

    printf 'Waiting for Cartographer /scan and /map before camera startup.\n'
    if ! compose exec --no-TTY "${SERVICE_NAME}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        timeout 45 bash -c '\''
            until ros2 topic list --no-daemon --spin-time 2 \
                    | grep -qx /scan \
                && ros2 topic list --no-daemon --spin-time 2 \
                    | grep -qx /map; do
                sleep 1
            done
        '\''
    '; then
        printf 'Cartographer did not become ready; stopping safely.\n' >&2
        stop_dogzilla
        return 1
    fi

    DOGZILLA_RTABMAP_DATABASE="${DOGZILLA_ROS_LOG_DIR}/rtabmap_mono_shadow.db"
    export DOGZILLA_RTABMAP_DATABASE
    if ! assert_camera_free; then
        stop_dogzilla
        return 1
    fi
    if ! compose up \
        --detach \
        --no-build \
        --force-recreate \
        "${SHADOW_SERVICE_NAME}"; then
        printf 'Visual shadow startup failed; stopping mapping safely.\n' >&2
        stop_dogzilla
        return 1
    fi

    printf 'Calibrated visual shadow mode started.\n'
    printf 'RTAB database: logs/sessions/%s/rtabmap_mono_shadow.db\n' \
        "${DOGZILLA_LOG_SESSION}"
    printf 'Run "dogzilla shadow-check 10" before moving.\n'
}

validate_vision_mode() {
    local mode="${1:-raw}"
    case "${mode}" in
        raw|color|color-track|color-action|face|face-track|watchdog|qr|qr-action|line|line-follow|objects|floor-hazards)
            printf '%s\n' "${mode}"
            ;;
        face-handshake)
            printf 'watchdog\n'
            ;;
        *)
            printf '%s\n' \
                'MODE must be raw, color, color-track, color-action, face, face-track, watchdog, qr, qr-action, line, line-follow, objects, or floor-hazards.' >&2
            return 2
            ;;
    esac
}

object_model_is_valid() {
    [[ -f "${OBJECT_MODEL_FILE}" ]] \
        && printf '%s  %s\n' \
            "${OBJECT_MODEL_SHA256}" "${OBJECT_MODEL_FILE}" \
            | sha256sum --check --status
}

open_images_model_is_valid() {
    [[ -f "${OPEN_IMAGES_MODEL_FILE}" ]] \
        && printf '%s  %s\n' \
            "${OPEN_IMAGES_MODEL_SHA256}" "${OPEN_IMAGES_MODEL_FILE}" \
            | sha256sum --check --status
}

install_object_model() {
    local temporary
    require_command curl
    require_command sha256sum
    mkdir -p "${OBJECT_MODEL_DIR}"
    if object_model_is_valid; then
        printf 'Pinned YOLOX-Nano model is already installed: %s\n' \
            "${OBJECT_MODEL_FILE}"
    else
        temporary="${OBJECT_MODEL_FILE}.partial.$$"
        printf 'Downloading the pinned 3.7 MB YOLOX-Nano ONNX model.\n'
        if ! curl --fail --location --silent --show-error \
            "${OBJECT_MODEL_URL}" --output "${temporary}"; then
            rm -f -- "${temporary}"
            return 1
        fi
        if ! printf '%s  %s\n' "${OBJECT_MODEL_SHA256}" "${temporary}" \
            | sha256sum --check --status; then
            printf 'Downloaded YOLOX model failed its SHA-256 check.\n' >&2
            rm -f -- "${temporary}"
            return 1
        fi
        chmod 0644 "${temporary}"
        mv -f -- "${temporary}" "${OBJECT_MODEL_FILE}"
        printf 'Installed verified OpenCV-DNN model: %s\n' \
            "${OBJECT_MODEL_FILE}"
    fi

    if open_images_model_is_valid; then
        printf 'Pinned Open Images model is already installed: %s\n' \
            "${OPEN_IMAGES_MODEL_FILE}"
        return 0
    fi
    temporary="${OPEN_IMAGES_MODEL_FILE}.partial.$$"
    printf '%s\n' \
        'Downloading the pinned 14.1 MB Open Images ONNX model.' \
        'Weights are AGPL-3.0; see models/README.md before redistribution.'
    if ! curl --fail --location --silent --show-error \
        "${OPEN_IMAGES_MODEL_URL}" --output "${temporary}"; then
        rm -f -- "${temporary}"
        return 1
    fi
    if ! printf '%s  %s\n' "${OPEN_IMAGES_MODEL_SHA256}" "${temporary}" \
        | sha256sum --check --status; then
        printf 'Downloaded Open Images model failed its SHA-256 check.\n' >&2
        rm -f -- "${temporary}"
        return 1
    fi
    chmod 0644 "${temporary}"
    mv -f -- "${temporary}" "${OPEN_IMAGES_MODEL_FILE}"
    printf 'Installed verified Open Images model: %s\n' \
        "${OPEN_IMAGES_MODEL_FILE}"
}

install_custom_object_model() {
    if (($# != 2)); then
        printf '%s\n' \
            'Usage: dogzilla object-model-custom-install MODEL LABELS' >&2
        return 2
    fi
    if vision_device_is_running; then
        printf '%s\n' \
            'Stop Mission Mode or vision before replacing object weights.' >&2
        return 1
    fi

    local source_model source_labels candidate_model candidate_labels
    if ! source_model="$(realpath -e -- "$1")" \
        || [[ ! -f "${source_model}" ]]; then
        printf 'Custom ONNX model does not exist: %s\n' "$1" >&2
        return 1
    fi
    if ! source_labels="$(realpath -e -- "$2")" \
        || [[ ! -f "${source_labels}" ]]; then
        printf 'Custom labels file does not exist: %s\n' "$2" >&2
        return 1
    fi
    candidate_model="${OBJECT_MODEL_DIR}/.custom-candidate-$$.onnx"
    candidate_labels="${OBJECT_MODEL_DIR}/.custom-candidate-$$.labels"
    cp -- "${source_model}" "${candidate_model}"
    cp -- "${source_labels}" "${candidate_labels}"
    chmod 0644 "${candidate_model}" "${candidate_labels}"

    if ! docker run --rm --network none \
        --volume "${REPO_ROOT}/ros2/dogzilla_slam:/workspace:ro" \
        --volume "${OBJECT_MODEL_DIR}:/models:ro" \
        --workdir /workspace \
        "${IMAGE_NAME}" \
        bash -lc \
        'source /opt/ros/humble/setup.bash &&
         PYTHONPATH=/workspace python3 -m dogzilla_slam.object_model_validate \
         "$1" "$2"' \
        bash "/models/$(basename -- "${candidate_model}")" \
        "/models/$(basename -- "${candidate_labels}")"; then
        rm -f -- "${candidate_model}" "${candidate_labels}"
        printf 'The active custom model was not changed.\n' >&2
        return 1
    fi

    mv -f -- "${candidate_labels}" \
        "${OBJECT_MODEL_DIR}/dogzilla_custom.labels"
    mv -f -- "${candidate_model}" \
        "${OBJECT_MODEL_DIR}/dogzilla_custom.onnx"
    printf '%s\n' \
        'Installed validated custom YOLOv8 model.' \
        'Run "dogzilla object-model-status" to confirm class coverage.'
}

