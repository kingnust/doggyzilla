open_teleop() {
    local speed_profile="${1:-normal}"
    local control_service
    local output_topic='/cmd_vel'
    local posture_controls=false
    local teleop_status

    if ! control_service="$(active_control_service)"; then
        printf 'No mapping, localization, or drive mode is running.\n' >&2
        printf 'Start one DOGZILLA mode first.\n' >&2
        exit 1
    fi
    case "${speed_profile}" in
        slow|normal|high)
            ;;
        *)
            printf 'Teleop speed must be slow, normal, or high.\n' >&2
            exit 1
            ;;
    esac

    if [[ "${control_service}" == "${DRIVE_SERVICE_NAME}" ]]; then
        posture_controls=true
    elif [[ "${control_service}" == "${NAVIGATION_SERVICE_NAME}" ]]; then
        output_topic='/cmd_vel_teleop'
    fi

    printf 'Initial teleop speed profile: %s\n' "${speed_profile}"
    printf 'Press 1, 2, or 3 in teleop to change speed live.\n'
    if [[ "${posture_controls}" == true ]]; then
        printf 'Body height and look controls are enabled in drive mode.\n'
    fi
    printf 'The controller returns to slow when teleop closes.\n'

    set +e
    compose exec "${control_service}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
        ros2 run dogzilla_slam teleop --ros-args \
            -p "initial_profile:=$1" \
            -p "output_topic:=$2" \
            -p "posture_controls:=$3"
    ' _ "${speed_profile}" "${output_topic}" "${posture_controls}"
    teleop_status=$?
    set -e

    if service_is_running "${control_service}" \
        && ! set_speed_profile "${control_service}" slow; then
        printf 'Warning: could not restore the slow speed profile.\n' >&2
        return 1
    fi
    return "${teleop_status}"
}

open_rviz() {
    local lidar_service
    local rviz_config
    if ! lidar_service="$(active_lidar_service)"; then
        printf 'Mapping or localization is not running.\n' >&2
        exit 1
    fi
    if [[ -z "${DISPLAY:-}" ]]; then
        printf 'This terminal has no DISPLAY. Run RViz from the Pi monitor.\n' >&2
        exit 1
    fi
    require_command xhost
    xhost +SI:localuser:root >/dev/null

    if [[ "${lidar_service}" == "${NAVIGATION_SERVICE_NAME}" ]]; then
        rviz_config='/opt/ros/humble/share/nav2_bringup/rviz/nav2_default_view.rviz'
    else
        rviz_config='/root/yahboomcar_ws/install/dogzilla_slam/share/dogzilla_slam/rviz/dogzilla_mapping.rviz'
    fi

    compose exec \
        --env "DISPLAY=${DISPLAY}" \
        "${lidar_service}" \
        bash -lc '
            source /opt/ros/humble/setup.bash
            source /root/yahboomcar_ws/install/setup.bash
            export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
            rviz2 -d "$1"
        ' _ "${rviz_config}"
}

save_map() {
    local map_name="${1:-}"
    require_running_container

    if [[ -z "${map_name}" ]]; then
        printf 'A map name is required. Example: save room1\n' >&2
        exit 1
    fi
    if [[ ! "${map_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
        printf 'Map name may contain only letters, numbers, dot, underscore, and dash.\n' >&2
        exit 1
    fi

    compose exec --no-TTY "${SERVICE_NAME}" bash -lc "
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        export ROS_DOMAIN_ID=\"\${ROS_DOMAIN_ID:-12}\"
        ros2 run dogzilla_slam save_map /maps/${map_name}
    "

    ls -lh \
        "${REPO_ROOT}/maps/${map_name}.pbstream" \
        "${REPO_ROOT}/maps/${map_name}.pgm" \
        "${REPO_ROOT}/maps/${map_name}.yaml"
}

open_shell() {
    local control_service
    if ! control_service="$(active_control_service)"; then
        printf 'No mapping, localization, or drive mode is running.\n' >&2
        exit 1
    fi
    compose exec "${control_service}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
        exec bash
    '
}

follow_logs() {
    local control_service
    if ! control_service="$(active_control_service)"; then
        printf 'No mapping, localization, or drive mode is running.\n' >&2
        exit 1
    fi
    if shadow_is_running; then
        compose logs --follow --tail 200 \
            "${control_service}" "${SHADOW_SERVICE_NAME}"
    else
        compose logs --follow --tail 200 "${control_service}"
    fi
}

stop_dogzilla() {
    local drive_was_running=false
    local lidar_status=0
    local mapping_was_running=false
    local mission_was_active=false
    local navigation_was_running=false
    local shadow_was_running=false
    local web_status=0

    reconcile_camera_calibration
    if [[ -f "${MISSION_STATE_FILE}" ]]; then
        mission_was_active=true
        printf 'Stopping the Mission Mode web gateway first.\n'
        if ! "${WEB_COMMAND}" stop; then
            web_status=1
        fi
    fi

    if shadow_is_running; then
        shadow_was_running=true
        printf 'Stopping the visual shadow service first.\n'
        compose stop --timeout 20 "${SHADOW_SERVICE_NAME}"
    fi

    if container_is_running; then
        mapping_was_running=true
        compose stop --timeout 20 "${SERVICE_NAME}"
    fi
    if drive_is_running; then
        drive_was_running=true
        compose stop --timeout 10 "${DRIVE_SERVICE_NAME}"
    fi
    if navigation_is_running; then
        navigation_was_running=true
        compose stop --timeout 20 "${NAVIGATION_SERVICE_NAME}"
    fi
    if [[ "${mapping_was_running}" == false \
        && "${drive_was_running}" == false \
        && "${navigation_was_running}" == false \
        && "${shadow_was_running}" == false ]]; then
        printf 'DOGZILLA is already stopped.\n'
    fi

    # Mapping may leave the scanner spinning after a process failure. Drive
    # mode never opens ttyAMA1, so it does not need or touch the LiDAR here.
    if [[ "${mapping_was_running}" == true \
        || "${navigation_was_running}" == true \
        || "${drive_was_running}" == false ]]; then
        if ! send_lidar_off; then
            lidar_status=1
        fi
    fi
    restore_oled_service

    if [[ -n "${DISPLAY:-}" ]] && command -v xhost >/dev/null 2>&1; then
        xhost -SI:localuser:root >/dev/null 2>&1 || true
    fi

    if ((lidar_status != 0 || web_status != 0)); then
        return 1
    fi
    if [[ "${mission_was_active}" == true ]]; then
        rm -f "${MISSION_STATE_FILE}" "${MISSION_STATE_FILE}.tmp"
    fi
    return 0
}

main() {
    require_command docker
    ensure_runtime_directories

    case "${1:-}" in
        doctor)
            run_doctor
            ;;
        build)
            build_image
            ;;
        start)
            start_mapping "${@:2}"
            ;;
        shadow)
            start_visual_shadow "${@:2}"
            ;;
        camera-check)
            check_camera "${2:-8}"
            ;;
        camera-calibrate)
            calibrate_camera_intrinsics "${@:2}"
            ;;
        camera-extrinsics)
            set_camera_extrinsics "${@:2}"
            ;;
        shadow-check)
            check_shadow "${2:-10}"
            ;;
        drive)
            start_drive
            ;;
        localize)
            start_navigation localize "${@:2}"
            ;;
        navigate)
            start_navigation navigate "${@:2}"
            ;;
        mission)
            "${MISSION_COMMAND}" "${@:2}"
            ;;
        status)
            show_status
            ;;
        teleop)
            open_teleop "${2:-normal}"
            ;;
        rviz)
            open_rviz
            ;;
        save)
            save_map "${2:-}"
            ;;
        lidar-off)
            send_lidar_off
            ;;
        rest-capture)
            run_firmware_rest_capture
            ;;
        rest)
            run_servo_mode rest
            ;;
        stand)
            run_servo_mode stand
            ;;
        imu-calibrate)
            run_imu_calibration
            ;;
        imu-check)
            check_imu "${2:-8}"
            ;;
        logs)
            follow_logs
            ;;
        shell)
            open_shell
            ;;
        stop)
            stop_dogzilla
            ;;
        desktop-install)
            install_desktop_shortcut
            ;;
        shutdown-install)
            install_shutdown_guard
            ;;
        help|-h|--help|'')
            usage
            ;;
        *)
            printf 'Unknown command: %s\n' "$1" >&2
            usage
            exit 1
            ;;
    esac
}

main "$@"
