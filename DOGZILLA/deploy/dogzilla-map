configure_navigation_options() {
    local mode="$1"
    local map_name='test1'
    shift

    if (($# > 0)) && [[ "$1" != --* ]]; then
        map_name="$1"
        shift
    fi
    if [[ ! "${map_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
        printf 'Map name may contain only letters, numbers, dot, underscore, and dash.\n' >&2
        exit 1
    fi
    for map_path in \
        "${REPO_ROOT}/maps/${map_name}.pbstream" \
        "${REPO_ROOT}/maps/${map_name}.yaml" \
        "${REPO_ROOT}/maps/${map_name}.pgm"; do
        if [[ ! -s "${map_path}" ]]; then
            printf 'Required localization map file is missing: %s\n' \
                "${map_path}" >&2
            exit 1
        fi
    done

    configure_start_options "$@"
    if [[ "${DOGZILLA_USE_IMU}" == 'true' ]]; then
        require_valid_imu_calibration
        DOGZILLA_CONFIGURATION_BASENAME='dogzilla_localization_imu.lua'
    else
        DOGZILLA_CONFIGURATION_BASENAME='dogzilla_localization.lua'
    fi

    DOGZILLA_MAP_NAME="${map_name}"
    DOGZILLA_MAP_YAML="/maps/${map_name}.yaml"
    DOGZILLA_STATE_FILE="/maps/${map_name}.pbstream"
    if [[ "${mode}" == 'navigate' ]]; then
        DOGZILLA_USE_NAV2=true
    else
        DOGZILLA_USE_NAV2=false
    fi
    export \
        DOGZILLA_CONFIGURATION_BASENAME \
        DOGZILLA_MAP_NAME \
        DOGZILLA_MAP_YAML \
        DOGZILLA_STATE_FILE \
        DOGZILLA_USE_NAV2
}

start_navigation() {
    local mode="$1"
    shift

    assert_mission_allows_start
    ensure_runtime_directories
    ensure_image
    if container_is_running || drive_is_running || shadow_is_running; then
        printf 'Mapping or drive mode is running. Stop it first.\n' >&2
        printf 'Run "./deploy/dogzilla-map stop" first.\n' >&2
        exit 1
    fi
    configure_navigation_options "${mode}" "$@"
    stop_vendor_application

    if navigation_is_running; then
        compose stop --timeout 20 "${NAVIGATION_SERVICE_NAME}"
    fi

    pause_oled_service
    if ! assert_serial_ports_free; then
        restore_oled_service
        return 1
    fi
    if ! enable_display_access; then
        restore_oled_service
        return 1
    fi
    begin_log_session

    if ! compose up \
        --detach \
        --no-build \
        --force-recreate \
        "${NAVIGATION_SERVICE_NAME}"; then
        restore_oled_service
        return 1
    fi

    if [[ "${mode}" == 'navigate' ]]; then
        printf 'DOGZILLA localization + Nav2 started on map %s.\n' \
            "${DOGZILLA_MAP_NAME}"
        printf 'Autonomous limits: 0.10 m/s linear, 0.30 rad/s angular.\n'
    else
        printf 'DOGZILLA pure localization started on map %s.\n' \
            "${DOGZILLA_MAP_NAME}"
        printf 'Nav2 path planning is not running in this mode.\n'
    fi
    printf 'Unknown/unmapped map cells remain non-traversable.\n'
    printf 'ROS log session: logs/sessions/%s (logs/latest).\n' \
        "${DOGZILLA_LOG_SESSION}"
    printf 'Use status, then RViz 2D Pose Estimate before sending a goal.\n'
}

