#!/usr/bin/env bash
set -Eeuo pipefail

DEPLOY_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${DEPLOY_DIR}/.." && pwd)"
COMPOSE_FILE="${DEPLOY_DIR}/compose.yaml"
SERVICE_NAME="mapping"
DRIVE_SERVICE_NAME="drive"
NAVIGATION_SERVICE_NAME="navigation"
IMAGE_NAME="dogzilla-mapping:humble"
BASE_IMAGE_NAME="yahboomtechnology/ros-humble:3.8"
PINNED_BASE_ALIAS="dogzilla-yahboom-base:3.8-pinned"
EXPECTED_BASE_IMAGE_ID="sha256:7e79c61b64b81311caf297640e5c6fd70279be4cbd38c2c087e8e3395e566047"
MINIMUM_BUILD_KB=2621440
OLED_SERVICE="yahboom_oled.service"
OLED_STATE_FILE="${REPO_ROOT}/logs/yahboom_oled.was-active"
CALIBRATION_FILE="${REPO_ROOT}/calibration/imu.json"
DESKTOP_TEMPLATE="${DEPLOY_DIR}/desktop/dogzilla-mapping.desktop"
SHUTDOWN_UNIT="dogzilla-mapping-shutdown.service"
SHUTDOWN_UNIT_SOURCE="${DEPLOY_DIR}/systemd/${SHUTDOWN_UNIT}"
MISSION_COMMAND="${DEPLOY_DIR}/dogzilla-mission"
MISSION_STATE_FILE="${REPO_ROOT}/logs/mission-current"
WEB_COMMAND="${DEPLOY_DIR}/dogzilla-web"

compose() {
    docker compose \
        --project-directory "${REPO_ROOT}" \
        --file "${COMPOSE_FILE}" \
        "$@"
}

usage() {
    printf '%s\n' \
        'Usage: ./deploy/dogzilla-map COMMAND [ARGUMENTS]' \
        '' \
        'Commands:' \
        '  doctor                Check Docker, devices, display, and disk space.' \
        '  build                 Build the pinned dogzilla-mapping image.' \
        '  start [--rviz|--headless] [--imu]' \
        '                        Start hardware and Cartographer together.' \
        '  drive                 Start controller-only mode; LiDAR stays off.' \
        '  localize [MAP] [--rviz|--headless] [--imu]' \
        '                        Localize on MAP (default: test1), without Nav2.' \
        '  navigate [MAP] [--rviz|--headless] [--imu]' \
        '                        Localize and start conservative Nav2 planning.' \
        '  mission [start] [MAP] [--rviz|--headless] [--imu]' \
        '                        Start Nav2 and the web dashboard together.' \
        '  mission status|logs|token|stop' \
        '                        Inspect or stop the managed mission session.' \
        '  status                Show container and ROS topic status.' \
        '  teleop [slow|normal|high]' \
        '                        Open keyboard control; default is normal.' \
        '  rviz                  Open RViz on the current Pi desktop.' \
        '  save MAP_NAME         Save MAP_NAME.pbstream/.pgm/.yaml to maps/.' \
        '  lidar-off             Stop the MS200 motor without starting ROS.' \
        '  rest-capture          Read-only capture of firmware low-battery rest.' \
        '  rest                  Disabled until firmware-rest profile capture.' \
        '  stand                 Play guarded animated stand-up action.' \
        '  imu-calibrate         Run safe guided six-pose IMU calibration.' \
        '  imu-check [SECONDS]   Validate fused IMU rate, gravity, and stamps.' \
        '  logs                  Follow logs for the active mode.' \
        '  shell                 Open a configured ROS shell.' \
        '  stop                  Safely stop mapping or controller-only mode.' \
        '  desktop-install       Install the optional Pi desktop shortcut.' \
        '  shutdown-install      Install the automatic OS-shutdown guard.'
}

require_command() {
    local command_name="$1"
    if ! command -v "${command_name}" >/dev/null 2>&1; then
        printf 'Required command not found: %s\n' "${command_name}" >&2
        exit 1
    fi
}

ensure_runtime_directories() {
    mkdir -p \
        "${REPO_ROOT}/maps" \
        "${REPO_ROOT}/logs/sessions" \
        "${REPO_ROOT}/calibration" \
        "${REPO_ROOT}/profiles/captures" \
        "${REPO_ROOT}/profiles/validated"
}

assert_mission_allows_start() {
    if [[ -f "${MISSION_STATE_FILE}" \
        && "${DOGZILLA_MISSION_START:-0}" != 1 ]]; then
        printf 'A managed Mission Mode session is still recorded.\n' >&2
        printf 'Run "./deploy/dogzilla-map mission stop" before starting another mode.\n' >&2
        exit 1
    fi
}

container_is_running() {
    service_is_running "${SERVICE_NAME}"
}

drive_is_running() {
    service_is_running "${DRIVE_SERVICE_NAME}"
}

navigation_is_running() {
    service_is_running "${NAVIGATION_SERVICE_NAME}"
}

service_is_running() {
    local service_name="$1"
    compose ps --status running --services 2>/dev/null \
        | grep -qx "${service_name}"
}

active_control_service() {
    if container_is_running; then
        printf '%s\n' "${SERVICE_NAME}"
    elif drive_is_running; then
        printf '%s\n' "${DRIVE_SERVICE_NAME}"
    elif navigation_is_running; then
        printf '%s\n' "${NAVIGATION_SERVICE_NAME}"
    else
        return 1
    fi
}

require_running_container() {
    if ! container_is_running; then
        printf 'DOGZILLA mapping is not running. Start it first.\n' >&2
        exit 1
    fi
}

active_lidar_service() {
    if container_is_running; then
        printf '%s\n' "${SERVICE_NAME}"
    elif navigation_is_running; then
        printf '%s\n' "${NAVIGATION_SERVICE_NAME}"
    else
        return 1
    fi
}

free_disk_kb() {
    df -Pk "${REPO_ROOT}" | awk 'NR == 2 {print $4}'
}

base_image_id() {
    docker image inspect --format '{{.Id}}' "${BASE_IMAGE_NAME}" 2>/dev/null
}

verify_base_image() {
    local actual_image_id

    if ! actual_image_id="$(base_image_id)"; then
        printf 'Downloading the expected Yahboom 3.8 base image.\n'
        docker pull "${BASE_IMAGE_NAME}"
        actual_image_id="$(base_image_id)"
    fi

    if [[ "${actual_image_id}" != "${EXPECTED_BASE_IMAGE_ID}" ]]; then
        printf 'Yahboom base-image mismatch.\n' >&2
        printf 'Expected: %s\n' "${EXPECTED_BASE_IMAGE_ID}" >&2
        printf 'Found:    %s\n' "${actual_image_id}" >&2
        printf 'The mutable 3.8 tag changed; review it before updating the pin.\n' >&2
        exit 1
    fi

    docker image tag "${BASE_IMAGE_NAME}" "${PINNED_BASE_ALIAS}"
}

run_doctor() {
    local failure=0
    local available_kb
    local actual_image_id

    require_command docker
    printf 'Docker: '
    docker --version
    printf 'Compose: '
    docker compose version

    if actual_image_id="$(base_image_id)"; then
        if [[ "${actual_image_id}" == "${EXPECTED_BASE_IMAGE_ID}" ]]; then
            printf 'Yahboom base image: verified %s\n' "${actual_image_id}"
        else
            printf 'Yahboom base image: unexpected %s\n' \
                "${actual_image_id}" >&2
            failure=1
        fi
    else
        printf 'Yahboom base image: not downloaded (build will download it).\n'
    fi

    for device_path in /dev/ttyAMA0 /dev/ttyAMA1; do
        if [[ -c "${device_path}" ]]; then
            printf 'Device OK: %s\n' "${device_path}"
        else
            printf 'Device missing: %s\n' "${device_path}" >&2
            failure=1
        fi
    done

    available_kb="$(free_disk_kb)"
    printf 'Free disk: %d MiB\n' "$((available_kb / 1024))"
    if ((available_kb < MINIMUM_BUILD_KB)); then
        printf 'Build warning: at least 2560 MiB free is recommended.\n' >&2
    fi

    if [[ -n "${DISPLAY:-}" ]]; then
        printf 'Desktop display: %s\n' "${DISPLAY}"
    else
        printf 'Desktop display: unavailable in this terminal (headless mode works).\n'
    fi

    return "${failure}"
}

build_image() {
    local available_kb
    ensure_runtime_directories
    available_kb="$(free_disk_kb)"

    if ((available_kb < MINIMUM_BUILD_KB)) \
        && [[ "${DOGZILLA_ALLOW_LOW_DISK:-0}" != '1' ]]; then
        printf 'Build refused: only %d MiB is free; 2560 MiB is required.\n' \
            "$((available_kb / 1024))" >&2
        printf 'Free or expand storage, then run the build again.\n' >&2
        printf 'Override only at your own risk with DOGZILLA_ALLOW_LOW_DISK=1.\n' >&2
        exit 1
    fi

    verify_base_image
    DOGZILLA_BASE_IMAGE="${PINNED_BASE_ALIAS}" compose build "${SERVICE_NAME}"
}

ensure_image() {
    if ! docker image inspect "${IMAGE_NAME}" >/dev/null 2>&1; then
        printf 'The reproducible image does not exist yet; building it now.\n'
        build_image
    fi
}

stop_vendor_application() {
    local kill_script="${REPO_ROOT}/app_dogzilla/kill_dogzilla.sh"
    if [[ -f "${kill_script}" ]]; then
        sh "${kill_script}"
    fi
}

pause_oled_service() {
    if ! command -v systemctl >/dev/null 2>&1; then
        return
    fi
    if systemctl is-active --quiet "${OLED_SERVICE}"; then
        printf 'Pausing %s while DOGZILLA ROS owns /dev/ttyAMA0.\n' \
            "${OLED_SERVICE}"
        sudo systemctl stop "${OLED_SERVICE}"
        : > "${OLED_STATE_FILE}"
    fi
}

restore_oled_service() {
    if [[ ! -f "${OLED_STATE_FILE}" ]]; then
        return
    fi

    printf 'Restoring %s.\n' "${OLED_SERVICE}"
    sudo systemctl start "${OLED_SERVICE}"
    rm -f "${OLED_STATE_FILE}"
}

send_lidar_off() {
    local helper_path="${REPO_ROOT}/ros2/dogzilla_slam/dogzilla_slam/lidar_off.py"

    assert_serial_ports_free /dev/ttyAMA1
    verify_base_image
    docker run \
        --rm \
        --device /dev/ttyAMA1:/dev/ttyAMA1 \
        --volume "${helper_path}:/opt/dogzilla/lidar_off.py:ro" \
        "${PINNED_BASE_ALIAS}" \
        python3 /opt/dogzilla/lidar_off.py /dev/ttyAMA1
}

confirm_servo_mode() {
    local confirmation
    local mode="$1"

    if [[ "${mode}" == 'rest' ]]; then
        printf '%s\n' \
            'SAFETY: REST is disabled.' \
            'Public action 1 is not verified as the firmware low-battery/power-button trajectory.' \
            'No movement or torque command will be sent until a real profile is captured and validated.' >&2
        return 1
    fi

    printf '%s\n' \
        'WARNING: STAND plays Yahboom animated stand-up action 2.' \
        'Support DOGZILLA on a clear, level floor and keep hands clear of joints.'
    printf 'Type STAND to confirm: '
    read -r confirmation
    [[ "${confirmation}" == 'STAND' ]]
}

run_servo_mode() {
    local command_status
    local mode="$1"

    if container_is_running || drive_is_running || navigation_is_running; then
        printf 'Stop mapping, localization, or drive mode before using %s.\n' \
            "${mode}" >&2
        printf 'Run "./deploy/dogzilla-map stop" first.\n' >&2
        exit 1
    fi

    ensure_image
    if ! confirm_servo_mode "${mode}"; then
        printf 'Cancelled; no servo command was sent.\n'
        return 1
    fi

    stop_vendor_application
    pause_oled_service
    if ! assert_serial_ports_free /dev/ttyAMA0; then
        restore_oled_service
        return 1
    fi

    set +e
    docker run \
        --rm \
        --interactive \
        --device /dev/ttyAMA0:/dev/ttyAMA0 \
        "${IMAGE_NAME}" \
        ros2 run dogzilla_slam servo_power "${mode}"
    command_status=$?
    set -e

    restore_oled_service
    return "${command_status}"
}

run_firmware_rest_capture() {
    local command_status
    local confirmation

    if container_is_running || drive_is_running || navigation_is_running; then
        printf 'Stop mapping, localization, navigation, or drive mode first.\n' >&2
        printf 'Run "./deploy/dogzilla-map stop" first.\n' >&2
        exit 1
    fi

    ensure_runtime_directories
    ensure_image
    printf '%s\n' \
        'READ-ONLY: this captures the controller low-battery trajectory.' \
        'It sends battery and joint read requests only; it never commands motion or torque.' \
        'Start only while DOGZILLA is stationary on a clear, level floor.' \
        'Do not press the physical power button; allow low battery to occur naturally.'
    printf 'Type CAPTURE to continue: '
    read -r confirmation
    if [[ "${confirmation}" != 'CAPTURE' ]]; then
        printf 'Cancelled; the serial port was not opened.\n'
        return 1
    fi

    stop_vendor_application
    pause_oled_service
    if ! assert_serial_ports_free /dev/ttyAMA0; then
        restore_oled_service
        return 1
    fi

    set +e
    docker run \
        --rm \
        --interactive \
        --device /dev/ttyAMA0:/dev/ttyAMA0 \
        --volume "${REPO_ROOT}/profiles:/profiles" \
        "${IMAGE_NAME}" \
        ros2 run dogzilla_slam firmware_rest_monitor
    command_status=$?
    set -e

    restore_oled_service
    return "${command_status}"
}

assert_serial_ports_free() {
    local device_path
    local device_paths=("$@")

    if ! command -v fuser >/dev/null 2>&1; then
        return
    fi

    if ((${#device_paths[@]} == 0)); then
        device_paths=(/dev/ttyAMA0 /dev/ttyAMA1)
    fi

    for device_path in "${device_paths[@]}"; do
        if fuser "${device_path}" >/dev/null 2>&1; then
            printf 'Serial device is already in use: %s\n' "${device_path}" >&2
            printf 'Stop the other DOGZILLA program or ROS launch first.\n' >&2
            return 1
        fi
    done
}

configure_start_options() {
    local display_mode='auto'
    local option
    DOGZILLA_USE_IMU=false
    DOGZILLA_CONFIGURATION_BASENAME='dogzilla_2d.lua'

    for option in "$@"; do
        case "${option}" in
            --rviz)
                display_mode='rviz'
                ;;
            --headless)
                display_mode='headless'
                ;;
            --imu)
                DOGZILLA_USE_IMU=true
                DOGZILLA_CONFIGURATION_BASENAME='dogzilla_2d_imu.lua'
                ;;
            *)
                printf 'Unknown start option: %s\n' "${option}" >&2
                usage
                exit 1
                ;;
        esac
    done

    if [[ "${display_mode}" == 'rviz' ]]; then
        if [[ -z "${DISPLAY:-}" ]]; then
            printf 'RViz requested, but this terminal has no DISPLAY.\n' >&2
            printf 'Run start --rviz from the terminal on the Pi monitor.\n' >&2
            exit 1
        fi
        DOGZILLA_RVIZ=true
    elif [[ "${display_mode}" == 'headless' ]]; then
        DOGZILLA_RVIZ=false
    elif [[ -n "${DISPLAY:-}" ]]; then
        DOGZILLA_RVIZ=true
    else
        DOGZILLA_RVIZ=false
    fi

    DOGZILLA_DISPLAY="${DISPLAY:-}"
    export \
        DOGZILLA_CONFIGURATION_BASENAME \
        DOGZILLA_DISPLAY \
        DOGZILLA_RVIZ \
        DOGZILLA_USE_IMU
}

require_valid_imu_calibration() {
    if [[ ! -f "${CALIBRATION_FILE}" ]]; then
        printf 'IMU fusion requires %s.\n' "${CALIBRATION_FILE}" >&2
        printf 'Run "./deploy/dogzilla-map imu-calibrate" first.\n' >&2
        exit 1
    fi

    if ! python3 -c '
import json, sys
with open(sys.argv[1], encoding="utf-8") as stream:
    calibration = json.load(stream)
if calibration.get("schema_version") != 1:
    raise SystemExit("Unsupported IMU calibration schema")
if calibration.get("axis_validated") is not True:
    raise SystemExit("IMU axis validation is incomplete")
' "${CALIBRATION_FILE}"; then
        printf 'IMU calibration is invalid; repeat the guided calibration.\n' >&2
        exit 1
    fi
}

begin_log_session() {
    local base_name
    local candidate
    local suffix=1

    base_name="$(date -u '+%Y%m%dT%H%M%SZ')"
    candidate="${base_name}"
    while [[ -e "${REPO_ROOT}/logs/sessions/${candidate}" ]]; do
        suffix=$((suffix + 1))
        candidate="${base_name}-${suffix}"
    done

    mkdir -p "${REPO_ROOT}/logs/sessions/${candidate}"
    ln -sfn "sessions/${candidate}" "${REPO_ROOT}/logs/latest"
    printf '%s\n' "${candidate}" > "${REPO_ROOT}/logs/current-session"
    DOGZILLA_ROS_LOG_DIR="/logs/sessions/${candidate}"
    DOGZILLA_LOG_SESSION="${candidate}"
    export DOGZILLA_LOG_SESSION DOGZILLA_ROS_LOG_DIR
}

enable_display_access() {
    if [[ "${DOGZILLA_RVIZ}" != 'true' ]]; then
        return
    fi
    require_command xhost
    xhost +SI:localuser:root >/dev/null
}

start_mapping() {
    assert_mission_allows_start
    ensure_runtime_directories
    ensure_image
    if drive_is_running || navigation_is_running; then
        printf 'Another DOGZILLA mode is running. Stop it before mapping.\n' >&2
        printf 'Run "./deploy/dogzilla-map stop" first.\n' >&2
        exit 1
    fi
    configure_start_options "$@"
    if [[ "${DOGZILLA_USE_IMU}" == 'true' ]]; then
        require_valid_imu_calibration
    fi
    stop_vendor_application

    if container_is_running; then
        compose stop --timeout 20 "${SERVICE_NAME}"
    fi

    pause_oled_service
    if ! assert_serial_ports_free; then
        restore_oled_service
        return 1
    fi
    if ! enable_display_access; then
        restore_oled_service
        return 1
    fi
    begin_log_session

    if ! compose up \
        --detach \
        --no-build \
        --force-recreate \
        "${SERVICE_NAME}"; then
        restore_oled_service
        return 1
    fi

    printf 'DOGZILLA mapping started.\n'
    if [[ "${DOGZILLA_USE_IMU}" == 'true' ]]; then
        printf 'Fusion profile: calibrated IMU + LiDAR scan matching.\n'
    else
        printf 'Fusion profile: LiDAR-only (use --imu after calibration).\n'
    fi
    printf 'ROS log session: logs/sessions/%s (logs/latest).\n' \
        "${DOGZILLA_LOG_SESSION}"
    printf 'Use "./deploy/dogzilla-map status" to check /scan and /map.\n'
    printf 'Use "./deploy/dogzilla-map logs" to watch Cartographer.\n'
}

start_drive() {
    assert_mission_allows_start
    ensure_runtime_directories
    ensure_image
    if container_is_running || navigation_is_running; then
        printf 'Mapping/localization is running. Stop it before drive mode.\n' >&2
        printf 'Run "./deploy/dogzilla-map stop" first.\n' >&2
        exit 1
    fi
    stop_vendor_application

    if drive_is_running; then
        compose stop --timeout 10 "${DRIVE_SERVICE_NAME}"
    fi

    pause_oled_service
    if ! assert_serial_ports_free /dev/ttyAMA0; then
        restore_oled_service
        return 1
    fi
    begin_log_session

    if ! compose up \
        --detach \
        --no-build \
        --force-recreate \
        "${DRIVE_SERVICE_NAME}"; then
        restore_oled_service
        return 1
    fi

    printf 'DOGZILLA controller-only mode started.\n'
    printf 'LiDAR, Cartographer, map generation, and RViz are not running.\n'
    printf 'ROS log session: logs/sessions/%s (logs/latest).\n' \
        "${DOGZILLA_LOG_SESSION}"
    printf 'Run "./deploy/dogzilla-map teleop" to drive.\n'
}

configure_navigation_options() {
    local mode="$1"
    local map_name='test1'
    shift

    if (($# > 0)) && [[ "$1" != --* ]]; then
        map_name="$1"
        shift
    fi
    if [[ ! "${map_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
        printf 'Map name may contain only letters, numbers, dot, underscore, and dash.\n' >&2
        exit 1
    fi
    for map_path in \
        "${REPO_ROOT}/maps/${map_name}.pbstream" \
        "${REPO_ROOT}/maps/${map_name}.yaml" \
        "${REPO_ROOT}/maps/${map_name}.pgm"; do
        if [[ ! -s "${map_path}" ]]; then
            printf 'Required localization map file is missing: %s\n' \
                "${map_path}" >&2
            exit 1
        fi
    done

    configure_start_options "$@"
    if [[ "${DOGZILLA_USE_IMU}" == 'true' ]]; then
        require_valid_imu_calibration
        DOGZILLA_CONFIGURATION_BASENAME='dogzilla_localization_imu.lua'
    else
        DOGZILLA_CONFIGURATION_BASENAME='dogzilla_localization.lua'
    fi

    DOGZILLA_MAP_NAME="${map_name}"
    DOGZILLA_MAP_YAML="/maps/${map_name}.yaml"
    DOGZILLA_STATE_FILE="/maps/${map_name}.pbstream"
    if [[ "${mode}" == 'navigate' ]]; then
        DOGZILLA_USE_NAV2=true
    else
        DOGZILLA_USE_NAV2=false
    fi
    export \
        DOGZILLA_CONFIGURATION_BASENAME \
        DOGZILLA_MAP_NAME \
        DOGZILLA_MAP_YAML \
        DOGZILLA_STATE_FILE \
        DOGZILLA_USE_NAV2
}

start_navigation() {
    local mode="$1"
    shift

    assert_mission_allows_start
    ensure_runtime_directories
    ensure_image
    if container_is_running || drive_is_running; then
        printf 'Mapping or drive mode is running. Stop it first.\n' >&2
        printf 'Run "./deploy/dogzilla-map stop" first.\n' >&2
        exit 1
    fi
    configure_navigation_options "${mode}" "$@"
    stop_vendor_application

    if navigation_is_running; then
        compose stop --timeout 20 "${NAVIGATION_SERVICE_NAME}"
    fi

    pause_oled_service
    if ! assert_serial_ports_free; then
        restore_oled_service
        return 1
    fi
    if ! enable_display_access; then
        restore_oled_service
        return 1
    fi
    begin_log_session

    if ! compose up \
        --detach \
        --no-build \
        --force-recreate \
        "${NAVIGATION_SERVICE_NAME}"; then
        restore_oled_service
        return 1
    fi

    if [[ "${mode}" == 'navigate' ]]; then
        printf 'DOGZILLA localization + Nav2 started on map %s.\n' \
            "${DOGZILLA_MAP_NAME}"
        printf 'Autonomous limits: 0.10 m/s linear, 0.30 rad/s angular.\n'
    else
        printf 'DOGZILLA pure localization started on map %s.\n' \
            "${DOGZILLA_MAP_NAME}"
        printf 'Nav2 path planning is not running in this mode.\n'
    fi
    printf 'Unknown/unmapped map cells remain non-traversable.\n'
    printf 'ROS log session: logs/sessions/%s (logs/latest).\n' \
        "${DOGZILLA_LOG_SESSION}"
    printf 'Use status, then RViz 2D Pose Estimate before sending a goal.\n'
}

run_imu_calibration() {
    local calibration_status

    if container_is_running || drive_is_running || navigation_is_running; then
        printf 'Stop every DOGZILLA mode before IMU calibration.\n' >&2
        printf 'Run "./deploy/dogzilla-map stop" first.\n' >&2
        exit 1
    fi

    ensure_image
    pause_oled_service
    if ! assert_serial_ports_free /dev/ttyAMA0; then
        restore_oled_service
        return 1
    fi

    set +e
    docker run \
        --rm \
        --interactive \
        --tty \
        --device /dev/ttyAMA0:/dev/ttyAMA0 \
        --volume "${REPO_ROOT}/calibration:/calibration" \
        "${IMAGE_NAME}" \
        ros2 run dogzilla_slam imu_calibrate \
        --output /calibration/imu.json \
        --owner-uid "$(id -u)" \
        --owner-gid "$(id -g)"
    calibration_status=$?
    set -e

    restore_oled_service
    return "${calibration_status}"
}

check_imu() {
    local duration="${1:-8}"
    local lidar_service
    if ! lidar_service="$(active_lidar_service)"; then
        printf 'Mapping or localization with IMU is not running.\n' >&2
        exit 1
    fi
    if [[ ! "${duration}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        printf 'SECONDS must be a positive number.\n' >&2
        exit 1
    fi

    compose exec --no-TTY "${lidar_service}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
        exec ros2 run dogzilla_slam imu_validate --duration "$1"
    ' _ "${duration}"
}

install_desktop_shortcut() {
    local desktop_directory
    if command -v xdg-user-dir >/dev/null 2>&1; then
        desktop_directory="$(xdg-user-dir DESKTOP)"
    else
        desktop_directory="${REPO_ROOT}/../Desktop"
    fi
    mkdir -p "${desktop_directory}"
    install -m 0755 \
        "${DESKTOP_TEMPLATE}" \
        "${desktop_directory}/DOGZILLA Mapping.desktop"
    printf 'Desktop shortcut installed: %s\n' \
        "${desktop_directory}/DOGZILLA Mapping.desktop"
}

install_shutdown_guard() {
    sudo install -m 0644 \
        "${SHUTDOWN_UNIT_SOURCE}" \
        "/etc/systemd/system/${SHUTDOWN_UNIT}"
    sudo systemctl daemon-reload
    sudo systemctl enable --now "${SHUTDOWN_UNIT}"
    printf 'Automatic safe-shutdown guard installed and enabled.\n'
}

show_status() {
    local control_service
    compose ps
    if ! control_service="$(active_control_service)"; then
        return
    fi

    printf '\nActive mode: %s\n' "${control_service}"
    compose exec --no-TTY "${control_service}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
        printf "\nROS topics:\n"
        ros2 topic list | sort
    '
}

set_speed_profile() {
    local control_service="$1"
    local speed_profile="$2"
    compose exec --no-TTY "${control_service}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
        ros2 param set /dogzilla_safe_base speed_profile "$1"
    ' _ "${speed_profile}"
}

open_teleop() {
    local speed_profile="${1:-normal}"
    local control_service
    local output_topic='/cmd_vel'
    local posture_controls=false
    local teleop_status

    if ! control_service="$(active_control_service)"; then
        printf 'No mapping, localization, or drive mode is running.\n' >&2
        printf 'Start one DOGZILLA mode first.\n' >&2
        exit 1
    fi
    case "${speed_profile}" in
        slow|normal|high)
            ;;
        *)
            printf 'Teleop speed must be slow, normal, or high.\n' >&2
            exit 1
            ;;
    esac

    if [[ "${control_service}" == "${DRIVE_SERVICE_NAME}" ]]; then
        posture_controls=true
    elif [[ "${control_service}" == "${NAVIGATION_SERVICE_NAME}" ]]; then
        output_topic='/cmd_vel_teleop'
    fi

    printf 'Initial teleop speed profile: %s\n' "${speed_profile}"
    printf 'Press 1, 2, or 3 in teleop to change speed live.\n'
    if [[ "${posture_controls}" == true ]]; then
        printf 'Body height and look controls are enabled in drive mode.\n'
    fi
    printf 'The controller returns to slow when teleop closes.\n'

    set +e
    compose exec "${control_service}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
        ros2 run dogzilla_slam teleop --ros-args \
            -p "initial_profile:=$1" \
            -p "output_topic:=$2" \
            -p "posture_controls:=$3"
    ' _ "${speed_profile}" "${output_topic}" "${posture_controls}"
    teleop_status=$?
    set -e

    if service_is_running "${control_service}" \
        && ! set_speed_profile "${control_service}" slow; then
        printf 'Warning: could not restore the slow speed profile.\n' >&2
        return 1
    fi
    return "${teleop_status}"
}

open_rviz() {
    local lidar_service
    local rviz_config
    if ! lidar_service="$(active_lidar_service)"; then
        printf 'Mapping or localization is not running.\n' >&2
        exit 1
    fi
    if [[ -z "${DISPLAY:-}" ]]; then
        printf 'This terminal has no DISPLAY. Run RViz from the Pi monitor.\n' >&2
        exit 1
    fi
    require_command xhost
    xhost +SI:localuser:root >/dev/null

    if [[ "${lidar_service}" == "${NAVIGATION_SERVICE_NAME}" ]]; then
        rviz_config='/opt/ros/humble/share/nav2_bringup/rviz/nav2_default_view.rviz'
    else
        rviz_config='/root/yahboomcar_ws/install/dogzilla_slam/share/dogzilla_slam/rviz/dogzilla_mapping.rviz'
    fi

    compose exec \
        --env "DISPLAY=${DISPLAY}" \
        "${lidar_service}" \
        bash -lc '
            source /opt/ros/humble/setup.bash
            source /root/yahboomcar_ws/install/setup.bash
            export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
            rviz2 -d "$1"
        ' _ "${rviz_config}"
}

save_map() {
    local map_name="${1:-}"
    require_running_container

    if [[ -z "${map_name}" ]]; then
        printf 'A map name is required. Example: save room1\n' >&2
        exit 1
    fi
    if [[ ! "${map_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
        printf 'Map name may contain only letters, numbers, dot, underscore, and dash.\n' >&2
        exit 1
    fi

    compose exec --no-TTY "${SERVICE_NAME}" bash -lc "
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        export ROS_DOMAIN_ID=\"\${ROS_DOMAIN_ID:-12}\"
        ros2 run dogzilla_slam save_map /maps/${map_name}
    "

    ls -lh \
        "${REPO_ROOT}/maps/${map_name}.pbstream" \
        "${REPO_ROOT}/maps/${map_name}.pgm" \
        "${REPO_ROOT}/maps/${map_name}.yaml"
}

open_shell() {
    local control_service
    if ! control_service="$(active_control_service)"; then
        printf 'No mapping, localization, or drive mode is running.\n' >&2
        exit 1
    fi
    compose exec "${control_service}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
        exec bash
    '
}

follow_logs() {
    local control_service
    if ! control_service="$(active_control_service)"; then
        printf 'No mapping, localization, or drive mode is running.\n' >&2
        exit 1
    fi
    compose logs --follow --tail 200 "${control_service}"
}

stop_dogzilla() {
    local drive_was_running=false
    local lidar_status=0
    local mapping_was_running=false
    local mission_was_active=false
    local navigation_was_running=false
    local web_status=0

    if [[ -f "${MISSION_STATE_FILE}" ]]; then
        mission_was_active=true
        printf 'Stopping the Mission Mode web gateway first.\n'
        if ! "${WEB_COMMAND}" stop; then
            web_status=1
        fi
    fi

    if container_is_running; then
        mapping_was_running=true
        compose stop --timeout 20 "${SERVICE_NAME}"
    fi
    if drive_is_running; then
        drive_was_running=true
        compose stop --timeout 10 "${DRIVE_SERVICE_NAME}"
    fi
    if navigation_is_running; then
        navigation_was_running=true
        compose stop --timeout 20 "${NAVIGATION_SERVICE_NAME}"
    fi
    if [[ "${mapping_was_running}" == false \
        && "${drive_was_running}" == false \
        && "${navigation_was_running}" == false ]]; then
        printf 'DOGZILLA is already stopped.\n'
    fi

    # Mapping may leave the scanner spinning after a process failure. Drive
    # mode never opens ttyAMA1, so it does not need or touch the LiDAR here.
    if [[ "${mapping_was_running}" == true \
        || "${navigation_was_running}" == true \
        || "${drive_was_running}" == false ]]; then
        if ! send_lidar_off; then
            lidar_status=1
        fi
    fi
    restore_oled_service

    if [[ -n "${DISPLAY:-}" ]] && command -v xhost >/dev/null 2>&1; then
        xhost -SI:localuser:root >/dev/null 2>&1 || true
    fi

    if ((lidar_status != 0 || web_status != 0)); then
        return 1
    fi
    if [[ "${mission_was_active}" == true ]]; then
        rm -f "${MISSION_STATE_FILE}" "${MISSION_STATE_FILE}.tmp"
    fi
    return 0
}

main() {
    require_command docker
    ensure_runtime_directories

    case "${1:-}" in
        doctor)
            run_doctor
            ;;
        build)
            build_image
            ;;
        start)
            start_mapping "${@:2}"
            ;;
        drive)
            start_drive
            ;;
        localize)
            start_navigation localize "${@:2}"
            ;;
        navigate)
            start_navigation navigate "${@:2}"
            ;;
        mission)
            "${MISSION_COMMAND}" "${@:2}"
            ;;
        status)
            show_status
            ;;
        teleop)
            open_teleop "${2:-normal}"
            ;;
        rviz)
            open_rviz
            ;;
        save)
            save_map "${2:-}"
            ;;
        lidar-off)
            send_lidar_off
            ;;
        rest-capture)
            run_firmware_rest_capture
            ;;
        rest)
            run_servo_mode rest
            ;;
        stand)
            run_servo_mode stand
            ;;
        imu-calibrate)
            run_imu_calibration
            ;;
        imu-check)
            check_imu "${2:-8}"
            ;;
        logs)
            follow_logs
            ;;
        shell)
            open_shell
            ;;
        stop)
            stop_dogzilla
            ;;
        desktop-install)
            install_desktop_shortcut
            ;;
        shutdown-install)
            install_shutdown_guard
            ;;
        help|-h|--help|'')
            usage
            ;;
        *)
            printf 'Unknown command: %s\n' "$1" >&2
            usage
            exit 1
            ;;
    esac
}

main "$@"
