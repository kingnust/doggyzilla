#!/usr/bin/env bash
set -Eeuo pipefail

DEPLOY_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "${DEPLOY_DIR}/.." && pwd)"
COMPOSE_FILE="${DEPLOY_DIR}/compose.yaml"
SERVICE_NAME="mapping"
DRIVE_SERVICE_NAME="drive"
NAVIGATION_SERVICE_NAME="navigation"
SHADOW_SERVICE_NAME="shadow"
IMAGE_NAME="dogzilla-mapping:humble"
BASE_IMAGE_NAME="yahboomtechnology/ros-humble:3.8"
PINNED_BASE_ALIAS="dogzilla-yahboom-base:3.8-pinned"
EXPECTED_BASE_IMAGE_ID="sha256:7e79c61b64b81311caf297640e5c6fd70279be4cbd38c2c087e8e3395e566047"
MINIMUM_BUILD_KB=2621440
OLED_SERVICE="yahboom_oled.service"
OLED_STATE_FILE="${REPO_ROOT}/logs/yahboom_oled.was-active"
CALIBRATION_FILE="${REPO_ROOT}/calibration/imu.json"
CAMERA_INTRINSICS_FILE="${REPO_ROOT}/calibration/camera.yaml"
CAMERA_EXTRINSICS_FILE="${REPO_ROOT}/calibration/camera_extrinsics.yaml"
CAMERA_MODEL_HELPER="${REPO_ROOT}/ros2/dogzilla_slam/dogzilla_slam/camera_model.py"
CAMERA_CALIBRATION_STATE="${REPO_ROOT}/logs/camera-calibration-current"
CAMERA_CALIBRATION_XHOST_STATE="${REPO_ROOT}/logs/camera-calibration-xhost"
DESKTOP_TEMPLATE="${DEPLOY_DIR}/desktop/dogzilla-mapping.desktop"
SHUTDOWN_UNIT="dogzilla-mapping-shutdown.service"
SHUTDOWN_UNIT_SOURCE="${DEPLOY_DIR}/systemd/${SHUTDOWN_UNIT}"
MISSION_COMMAND="${DEPLOY_DIR}/dogzilla-mission"
MISSION_STATE_FILE="${REPO_ROOT}/logs/mission-current"
WEB_COMMAND="${DEPLOY_DIR}/dogzilla-web"

compose() {
    docker compose \
        --project-directory "${REPO_ROOT}" \
        --file "${COMPOSE_FILE}" \
        "$@"
}

usage() {
    printf '%s\n' \
        'Usage: ./deploy/dogzilla-map COMMAND [ARGUMENTS]' \
        '' \
        'Commands:' \
        '  doctor                Check Docker, devices, display, and disk space.' \
        '  build                 Build the pinned dogzilla-mapping image.' \
        '  start [--rviz|--headless] [--imu]' \
        '                        Start hardware and Cartographer together.' \
        '  shadow [--rviz|--headless] [--imu]' \
        '                        Map with calibrated mono RTAB shadow mode.' \
        '  camera-check [SECONDS]' \
        '                        Test /dev/video0 without moving the robot.' \
        '  camera-calibrate BOARD_SIZE SQUARE_METRES' \
        '                        Calibrate 640x480 intrinsics on the Pi display.' \
        '  camera-extrinsics --measured X Y Z ROLL PITCH YAW' \
        '                        Save measured XYZ metres and RPY degrees.' \
        '  shadow-check [SECONDS]' \
        '                        Validate the active calibrated shadow stream.' \
        '  drive                 Start controller-only mode; LiDAR stays off.' \
        '  localize [MAP] [--rviz|--headless] [--imu]' \
        '                        Localize on MAP (default: test1), without Nav2.' \
        '  navigate [MAP] [--rviz|--headless] [--imu]' \
        '                        Localize and start conservative Nav2 planning.' \
        '  mission [start] [MAP] [--rviz|--headless] [--imu]' \
        '                        Start Nav2 and the web dashboard together.' \
        '  mission status|logs|token|stop' \
        '                        Inspect or stop the managed mission session.' \
        '  status                Show container and ROS topic status.' \
        '  teleop [slow|normal|high]' \
        '                        Open keyboard control; default is normal.' \
        '  rviz                  Open RViz on the current Pi desktop.' \
        '  save MAP_NAME         Save MAP_NAME.pbstream/.pgm/.yaml to maps/.' \
        '  lidar-off             Stop the MS200 motor without starting ROS.' \
        '  rest-capture          Read-only capture of firmware low-battery rest.' \
        '  rest                  Disabled until firmware-rest profile capture.' \
        '  stand                 Play guarded animated stand-up action.' \
        '  imu-calibrate         Run safe guided six-pose IMU calibration.' \
        '  imu-check [SECONDS]   Validate fused IMU rate, gravity, and stamps.' \
        '  logs                  Follow logs for the active mode.' \
        '  shell                 Open a configured ROS shell.' \
        '  stop                  Safely stop mapping or controller-only mode.' \
        '  desktop-install       Install the optional Pi desktop shortcut.' \
        '  shutdown-install      Install the automatic OS-shutdown guard.'
}

require_command() {
    local command_name="$1"
    if ! command -v "${command_name}" >/dev/null 2>&1; then
        printf 'Required command not found: %s\n' "${command_name}" >&2
        exit 1
    fi
}

ensure_runtime_directories() {
    mkdir -p \
        "${REPO_ROOT}/maps" \
        "${REPO_ROOT}/logs/sessions" \
        "${REPO_ROOT}/calibration" \
        "${REPO_ROOT}/profiles/captures" \
        "${REPO_ROOT}/profiles/validated"
}

assert_mission_allows_start() {
    if [[ -f "${MISSION_STATE_FILE}" \
        && "${DOGZILLA_MISSION_START:-0}" != 1 ]]; then
        printf 'A managed Mission Mode session is still recorded.\n' >&2
        printf 'Run "./deploy/dogzilla-map mission stop" before starting another mode.\n' >&2
        exit 1
    fi
}

container_is_running() {
    service_is_running "${SERVICE_NAME}"
}

drive_is_running() {
    service_is_running "${DRIVE_SERVICE_NAME}"
}

navigation_is_running() {
    service_is_running "${NAVIGATION_SERVICE_NAME}"
}

shadow_is_running() {
    service_is_running "${SHADOW_SERVICE_NAME}"
}

service_is_running() {
    local service_name="$1"
    compose ps --status running --services 2>/dev/null \
        | grep -qx "${service_name}"
}

active_control_service() {
    if container_is_running; then
        printf '%s\n' "${SERVICE_NAME}"
    elif drive_is_running; then
        printf '%s\n' "${DRIVE_SERVICE_NAME}"
    elif navigation_is_running; then
        printf '%s\n' "${NAVIGATION_SERVICE_NAME}"
    else
        return 1
    fi
}

require_running_container() {
    if ! container_is_running; then
        printf 'DOGZILLA mapping is not running. Start it first.\n' >&2
        exit 1
    fi
}

active_lidar_service() {
    if container_is_running; then
        printf '%s\n' "${SERVICE_NAME}"
    elif navigation_is_running; then
        printf '%s\n' "${NAVIGATION_SERVICE_NAME}"
    else
        return 1
    fi
}

free_disk_kb() {
    df -Pk "${REPO_ROOT}" | awk 'NR == 2 {print $4}'
}

base_image_id() {
    docker image inspect --format '{{.Id}}' "${BASE_IMAGE_NAME}" 2>/dev/null
}

verify_base_image() {
    local actual_image_id

    if ! actual_image_id="$(base_image_id)"; then
        printf 'Downloading the expected Yahboom 3.8 base image.\n'
        docker pull "${BASE_IMAGE_NAME}"
        actual_image_id="$(base_image_id)"
    fi

    if [[ "${actual_image_id}" != "${EXPECTED_BASE_IMAGE_ID}" ]]; then
        printf 'Yahboom base-image mismatch.\n' >&2
        printf 'Expected: %s\n' "${EXPECTED_BASE_IMAGE_ID}" >&2
        printf 'Found:    %s\n' "${actual_image_id}" >&2
        printf 'The mutable 3.8 tag changed; review it before updating the pin.\n' >&2
        exit 1
    fi

    docker image tag "${BASE_IMAGE_NAME}" "${PINNED_BASE_ALIAS}"
}

run_doctor() {
    local failure=0
    local available_kb
    local actual_image_id

    require_command docker
    printf 'Docker: '
    docker --version
    printf 'Compose: '
    docker compose version

    if actual_image_id="$(base_image_id)"; then
        if [[ "${actual_image_id}" == "${EXPECTED_BASE_IMAGE_ID}" ]]; then
            printf 'Yahboom base image: verified %s\n' "${actual_image_id}"
        else
            printf 'Yahboom base image: unexpected %s\n' \
                "${actual_image_id}" >&2
            failure=1
        fi
    else
        printf 'Yahboom base image: not downloaded (build will download it).\n'
    fi

    for device_path in /dev/ttyAMA0 /dev/ttyAMA1; do
        if [[ -c "${device_path}" ]]; then
            printf 'Device OK: %s\n' "${device_path}"
        else
            printf 'Device missing: %s\n' "${device_path}" >&2
            failure=1
        fi
    done

    available_kb="$(free_disk_kb)"
    printf 'Free disk: %d MiB\n' "$((available_kb / 1024))"
    if ((available_kb < MINIMUM_BUILD_KB)); then
        printf 'Build warning: at least 2560 MiB free is recommended.\n' >&2
    fi

    if [[ -n "${DISPLAY:-}" ]]; then
        printf 'Desktop display: %s\n' "${DISPLAY}"
    else
        printf 'Desktop display: unavailable in this terminal (headless mode works).\n'
    fi

    return "${failure}"
}

build_image() {
    local available_kb
    ensure_runtime_directories
    available_kb="$(free_disk_kb)"

    if ((available_kb < MINIMUM_BUILD_KB)) \
        && [[ "${DOGZILLA_ALLOW_LOW_DISK:-0}" != '1' ]]; then
        printf 'Build refused: only %d MiB is free; 2560 MiB is required.\n' \
            "$((available_kb / 1024))" >&2
        printf 'Free or expand storage, then run the build again.\n' >&2
        printf 'Override only at your own risk with DOGZILLA_ALLOW_LOW_DISK=1.\n' >&2
        exit 1
    fi

    verify_base_image
    DOGZILLA_BASE_IMAGE="${PINNED_BASE_ALIAS}" compose build "${SERVICE_NAME}"
}

ensure_image() {
    if ! docker image inspect "${IMAGE_NAME}" >/dev/null 2>&1; then
        printf 'The reproducible image does not exist yet; building it now.\n'
        build_image
    fi
}

stop_vendor_application() {
    local any_alive
    local attempt
    local owner_pid
    local vendor_path="${REPO_ROOT}/app_dogzilla/app_dogzilla.py"
    local vendor_pids=()

    mapfile -t vendor_pids < <(
        pgrep -f "^python3 ${vendor_path//./\\.}([[:space:]]|$)" || true
    )
    if ((${#vendor_pids[@]} == 0)); then
        return
    fi

    printf 'Stopping the Yahboom application through its Ctrl-C cleanup path.\n'
    kill -INT "${vendor_pids[@]}"
    for attempt in {1..50}; do
        any_alive=false
        for owner_pid in "${vendor_pids[@]}"; do
            if kill -0 "${owner_pid}" 2>/dev/null; then
                any_alive=true
            fi
        done
        if [[ "${any_alive}" == false ]]; then
            return
        fi
        sleep 0.1
    done
    printf '%s\n' \
        'Yahboom application did not stop after Ctrl-C.' \
        'Refusing to use kill -9; close it manually and retry.' >&2
    return 1
}

assert_camera_free() {
    local command_name
    local owner_pid
    local unexpected_owners=()

    if ! command -v fuser >/dev/null 2>&1; then
        return
    fi
    for owner_pid in $(fuser /dev/video0 2>/dev/null || true); do
        command_name="$(ps -p "${owner_pid}" -o comm= 2>/dev/null || true)"
        case "${command_name}" in
            pipewire|wireplumber)
                ;;
            *)
                unexpected_owners+=("${owner_pid}:${command_name:-unknown}")
                ;;
        esac
    done
    if ((${#unexpected_owners[@]} > 0)); then
        printf 'Camera device is already in use: /dev/video0\n' >&2
        printf 'Owners: %s\n' "${unexpected_owners[*]}" >&2
        printf 'Close the other camera program and retry.\n' >&2
        return 1
    fi
}

pause_oled_service() {
    if ! command -v systemctl >/dev/null 2>&1; then
        return
    fi
    if systemctl is-active --quiet "${OLED_SERVICE}"; then
        printf 'Pausing %s while DOGZILLA ROS owns /dev/ttyAMA0.\n' \
            "${OLED_SERVICE}"
        sudo systemctl stop "${OLED_SERVICE}"
        : > "${OLED_STATE_FILE}"
    fi
}

restore_oled_service() {
    if [[ ! -f "${OLED_STATE_FILE}" ]]; then
        return
    fi

    printf 'Restoring %s.\n' "${OLED_SERVICE}"
    sudo systemctl start "${OLED_SERVICE}"
    rm -f "${OLED_STATE_FILE}"
}

send_lidar_off() {
    local helper_path="${REPO_ROOT}/ros2/dogzilla_slam/dogzilla_slam/lidar_off.py"

    assert_serial_ports_free /dev/ttyAMA1
    verify_base_image
    docker run \
        --rm \
        --device /dev/ttyAMA1:/dev/ttyAMA1 \
        --volume "${helper_path}:/opt/dogzilla/lidar_off.py:ro" \
        "${PINNED_BASE_ALIAS}" \
        python3 /opt/dogzilla/lidar_off.py /dev/ttyAMA1
}

confirm_servo_mode() {
    local confirmation
    local mode="$1"

    if [[ "${mode}" == 'rest' ]]; then
        printf '%s\n' \
            'SAFETY: REST is disabled.' \
            'Public action 1 is not verified as the firmware low-battery/power-button trajectory.' \
            'No movement or torque command will be sent until a real profile is captured and validated.' >&2
        return 1
    fi

    printf '%s\n' \
        'WARNING: STAND plays Yahboom animated stand-up action 2.' \
        'Support DOGZILLA on a clear, level floor and keep hands clear of joints.'
    printf 'Type STAND to confirm: '
    read -r confirmation
    [[ "${confirmation}" == 'STAND' ]]
}

run_servo_mode() {
    local command_status
    local mode="$1"

    if container_is_running || drive_is_running || navigation_is_running \
        || shadow_is_running; then
        printf 'Stop mapping, localization, or drive mode before using %s.\n' \
            "${mode}" >&2
        printf 'Run "./deploy/dogzilla-map stop" first.\n' >&2
        exit 1
    fi

    ensure_image
    if ! confirm_servo_mode "${mode}"; then
        printf 'Cancelled; no servo command was sent.\n'
        return 1
    fi

    stop_vendor_application
    pause_oled_service
    if ! assert_serial_ports_free /dev/ttyAMA0; then
        restore_oled_service
        return 1
    fi

    set +e
    docker run \
        --rm \
        --interactive \
        --device /dev/ttyAMA0:/dev/ttyAMA0 \
        "${IMAGE_NAME}" \
        ros2 run dogzilla_slam servo_power "${mode}"
    command_status=$?
    set -e

    restore_oled_service
    return "${command_status}"
}

run_firmware_rest_capture() {
    local command_status
    local confirmation

    if container_is_running || drive_is_running || navigation_is_running \
        || shadow_is_running; then
        printf 'Stop mapping, localization, navigation, or drive mode first.\n' >&2
        printf 'Run "./deploy/dogzilla-map stop" first.\n' >&2
        exit 1
    fi

    ensure_runtime_directories
    ensure_image
    printf '%s\n' \
        'READ-ONLY: this captures the controller low-battery trajectory.' \
        'It sends battery and joint read requests only; it never commands motion or torque.' \
        'Start only while DOGZILLA is stationary on a clear, level floor.' \
        'Do not press the physical power button; allow low battery to occur naturally.'
    printf 'Type CAPTURE to continue: '
    read -r confirmation
    if [[ "${confirmation}" != 'CAPTURE' ]]; then
        printf 'Cancelled; the serial port was not opened.\n'
        return 1
    fi

    stop_vendor_application
    pause_oled_service
    if ! assert_serial_ports_free /dev/ttyAMA0; then
        restore_oled_service
        return 1
    fi

    set +e
    docker run \
        --rm \
        --interactive \
        --device /dev/ttyAMA0:/dev/ttyAMA0 \
        --volume "${REPO_ROOT}/profiles:/profiles" \
        "${IMAGE_NAME}" \
        ros2 run dogzilla_slam firmware_rest_monitor
    command_status=$?
    set -e

    restore_oled_service
    return "${command_status}"
}

assert_serial_ports_free() {
    local device_path
    local device_paths=("$@")

    if ! command -v fuser >/dev/null 2>&1; then
        return
    fi

    if ((${#device_paths[@]} == 0)); then
        device_paths=(/dev/ttyAMA0 /dev/ttyAMA1)
    fi

    for device_path in "${device_paths[@]}"; do
        if fuser "${device_path}" >/dev/null 2>&1; then
            printf 'Serial device is already in use: %s\n' "${device_path}" >&2
            printf 'Stop the other DOGZILLA program or ROS launch first.\n' >&2
            return 1
        fi
    done
}

configure_start_options() {
    local display_mode='auto'
    local option
    DOGZILLA_USE_IMU=false
    DOGZILLA_CONFIGURATION_BASENAME='dogzilla_2d.lua'

    for option in "$@"; do
        case "${option}" in
            --rviz)
                display_mode='rviz'
                ;;
            --headless)
                display_mode='headless'
                ;;
            --imu)
                DOGZILLA_USE_IMU=true
                DOGZILLA_CONFIGURATION_BASENAME='dogzilla_2d_imu.lua'
                ;;
            *)
                printf 'Unknown start option: %s\n' "${option}" >&2
                usage
                exit 1
                ;;
        esac
    done

    if [[ "${display_mode}" == 'rviz' ]]; then
        if [[ -z "${DISPLAY:-}" ]]; then
            printf 'RViz requested, but this terminal has no DISPLAY.\n' >&2
            printf 'Run start --rviz from the terminal on the Pi monitor.\n' >&2
            exit 1
        fi
        DOGZILLA_RVIZ=true
    elif [[ "${display_mode}" == 'headless' ]]; then
        DOGZILLA_RVIZ=false
    elif [[ -n "${DISPLAY:-}" ]]; then
        DOGZILLA_RVIZ=true
    else
        DOGZILLA_RVIZ=false
    fi

    DOGZILLA_DISPLAY="${DISPLAY:-}"
    export \
        DOGZILLA_CONFIGURATION_BASENAME \
        DOGZILLA_DISPLAY \
        DOGZILLA_RVIZ \
        DOGZILLA_USE_IMU
}

require_valid_imu_calibration() {
    if [[ ! -f "${CALIBRATION_FILE}" ]]; then
        printf 'IMU fusion requires %s.\n' "${CALIBRATION_FILE}" >&2
        printf 'Run "./deploy/dogzilla-map imu-calibrate" first.\n' >&2
        exit 1
    fi

    if ! python3 -c '
import json, sys
with open(sys.argv[1], encoding="utf-8") as stream:
    calibration = json.load(stream)
if calibration.get("schema_version") != 1:
    raise SystemExit("Unsupported IMU calibration schema")
if calibration.get("axis_validated") is not True:
    raise SystemExit("IMU axis validation is incomplete")
' "${CALIBRATION_FILE}"; then
        printf 'IMU calibration is invalid; repeat the guided calibration.\n' >&2
        exit 1
    fi
}

require_valid_camera_model() {
    local pose

    if ! pose="$(python3 "${CAMERA_MODEL_HELPER}" \
        --intrinsics "${CAMERA_INTRINSICS_FILE}" \
        --extrinsics "${CAMERA_EXTRINSICS_FILE}" \
        --print-pose)"; then
        printf '%s\n' \
            'Visual shadow mode was not started.' \
            'Create camera.yaml with ROS camera_calibration at 640x480,' \
            'then measure calibration/camera_extrinsics.yaml.' >&2
        return 1
    fi

    read -r \
        DOGZILLA_CAMERA_X \
        DOGZILLA_CAMERA_Y \
        DOGZILLA_CAMERA_Z \
        DOGZILLA_CAMERA_ROLL \
        DOGZILLA_CAMERA_PITCH \
        DOGZILLA_CAMERA_YAW <<< "${pose}"
    export \
        DOGZILLA_CAMERA_X \
        DOGZILLA_CAMERA_Y \
        DOGZILLA_CAMERA_Z \
        DOGZILLA_CAMERA_ROLL \
        DOGZILLA_CAMERA_PITCH \
        DOGZILLA_CAMERA_YAW
}

begin_log_session() {
    local base_name
    local candidate
    local suffix=1

    base_name="$(date -u '+%Y%m%dT%H%M%SZ')"
    candidate="${base_name}"
    while [[ -e "${REPO_ROOT}/logs/sessions/${candidate}" ]]; do
        suffix=$((suffix + 1))
        candidate="${base_name}-${suffix}"
    done

    mkdir -p "${REPO_ROOT}/logs/sessions/${candidate}"
    ln -sfn "sessions/${candidate}" "${REPO_ROOT}/logs/latest"
    printf '%s\n' "${candidate}" > "${REPO_ROOT}/logs/current-session"
    DOGZILLA_ROS_LOG_DIR="/logs/sessions/${candidate}"
    DOGZILLA_LOG_SESSION="${candidate}"
    export DOGZILLA_LOG_SESSION DOGZILLA_ROS_LOG_DIR
}

enable_display_access() {
    if [[ "${DOGZILLA_RVIZ}" != 'true' ]]; then
        return
    fi
    require_command xhost
    xhost +SI:localuser:root >/dev/null
}

start_mapping() {
    assert_mission_allows_start
    ensure_runtime_directories
    ensure_image
    if drive_is_running || navigation_is_running || shadow_is_running; then
        printf 'Another DOGZILLA mode is running. Stop it before mapping.\n' >&2
        printf 'Run "./deploy/dogzilla-map stop" first.\n' >&2
        exit 1
    fi
    configure_start_options "$@"
    if [[ "${DOGZILLA_USE_IMU}" == 'true' ]]; then
        require_valid_imu_calibration
    fi
    stop_vendor_application

    if container_is_running; then
        compose stop --timeout 20 "${SERVICE_NAME}"
    fi

    pause_oled_service
    if ! assert_serial_ports_free; then
        restore_oled_service
        return 1
    fi
    if ! enable_display_access; then
        restore_oled_service
        return 1
    fi
    begin_log_session

    if ! compose up \
        --detach \
        --no-build \
        --force-recreate \
        "${SERVICE_NAME}"; then
        restore_oled_service
        return 1
    fi

    printf 'DOGZILLA mapping started.\n'
    if [[ "${DOGZILLA_USE_IMU}" == 'true' ]]; then
        printf 'Fusion profile: calibrated IMU + LiDAR scan matching.\n'
    else
        printf 'Fusion profile: LiDAR-only (use --imu after calibration).\n'
    fi
    printf 'ROS log session: logs/sessions/%s (logs/latest).\n' \
        "${DOGZILLA_LOG_SESSION}"
    printf 'Use "./deploy/dogzilla-map status" to check /scan and /map.\n'
    printf 'Use "./deploy/dogzilla-map logs" to watch Cartographer.\n'
}

start_visual_shadow() {
    reconcile_camera_calibration
    if container_is_running || drive_is_running || navigation_is_running \
        || shadow_is_running; then
        printf 'Another DOGZILLA mode is running. Stop it before shadow mode.\n' >&2
        printf 'Run "./deploy/dogzilla-map stop" first.\n' >&2
        exit 1
    fi
    if [[ ! -c /dev/video0 ]]; then
        printf 'Camera device is missing: /dev/video0\n' >&2
        exit 1
    fi
    require_valid_camera_model
    start_mapping "$@"

    printf 'Waiting for Cartographer /scan and /map before camera startup.\n'
    if ! compose exec --no-TTY "${SERVICE_NAME}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        timeout 45 bash -c '\''
            until ros2 topic list --no-daemon --spin-time 2 \
                    | grep -qx /scan \
                && ros2 topic list --no-daemon --spin-time 2 \
                    | grep -qx /map; do
                sleep 1
            done
        '\''
    '; then
        printf 'Cartographer did not become ready; stopping safely.\n' >&2
        stop_dogzilla
        return 1
    fi

    DOGZILLA_RTABMAP_DATABASE="${DOGZILLA_ROS_LOG_DIR}/rtabmap_mono_shadow.db"
    export DOGZILLA_RTABMAP_DATABASE
    if ! assert_camera_free; then
        stop_dogzilla
        return 1
    fi
    if ! compose up \
        --detach \
        --no-build \
        --force-recreate \
        "${SHADOW_SERVICE_NAME}"; then
        printf 'Visual shadow startup failed; stopping mapping safely.\n' >&2
        stop_dogzilla
        return 1
    fi

    printf 'Calibrated visual shadow mode started.\n'
    printf 'RTAB database: logs/sessions/%s/rtabmap_mono_shadow.db\n' \
        "${DOGZILLA_LOG_SESSION}"
    printf 'Run "./deploy/dogzilla-map shadow-check 10" before moving.\n'
}

select_local_display() {
    local display_number

    if [[ "${DISPLAY:-}" =~ ^:([0-9]+)(\.[0-9]+)?$ ]]; then
        display_number="${BASH_REMATCH[1]}"
        if [[ -S "/tmp/.X11-unix/X${display_number}" ]]; then
            return
        fi
    fi
    for display_number in {0..9}; do
        if [[ -S "/tmp/.X11-unix/X${display_number}" ]]; then
            DISPLAY=":${display_number}"
            export DISPLAY
            printf 'Using the Pi desktop display %s.\n' "${DISPLAY}"
            return
        fi
    done
    printf '%s\n' \
        'Camera calibration requires the Raspberry Pi desktop.' \
        'Log into the Pi monitor desktop, then retry from a terminal.' >&2
    return 1
}

validate_camera_intrinsics_file() {
    python3 -c '
import sys
sys.path.insert(0, sys.argv[2])
from dogzilla_slam.camera_model import validate_intrinsics
validate_intrinsics(sys.argv[1])
' "$1" "${REPO_ROOT}/ros2/dogzilla_slam"
}

install_camera_intrinsics_file() {
    local install_source="$1"
    local install_stage

    validate_camera_intrinsics_file "${install_source}"
    if [[ -f "${CAMERA_INTRINSICS_FILE}" ]]; then
        cp --preserve=mode,timestamps \
            "${CAMERA_INTRINSICS_FILE}" \
            "${REPO_ROOT}/calibration/camera.backup.$(
                date -u '+%Y%m%dT%H%M%S%NZ'
            ).yaml"
    fi
    install_stage="$(mktemp \
        "${REPO_ROOT}/calibration/.camera.install.XXXXXX.yaml")"
    if ! install -m 0644 "${install_source}" "${install_stage}"; then
        rm -f -- "${install_stage}"
        return 1
    fi
    mv -f -- "${install_stage}" "${CAMERA_INTRINSICS_FILE}"
}

revoke_camera_calibration_display() {
    local display_number
    local revoked=false

    if [[ ! -f "${CAMERA_CALIBRATION_XHOST_STATE}" ]]; then
        return
    fi
    if ! command -v xhost >/dev/null 2>&1; then
        return 1
    fi
    for display_number in {0..9}; do
        if [[ -S "/tmp/.X11-unix/X${display_number}" ]] \
            && DISPLAY=":${display_number}" \
                xhost -SI:localuser:root >/dev/null 2>&1; then
            revoked=true
        fi
    done
    if [[ "${revoked}" == true ]]; then
        rm -f -- "${CAMERA_CALIBRATION_XHOST_STATE}"
        return
    fi
    return 1
}

reconcile_camera_calibration() {
    local calibration_container='dogzilla_camera_calibration'
    local container_role
    local pending_directory
    local pending_path

    revoke_camera_calibration_display || true
    if docker container inspect "${calibration_container}" \
        >/dev/null 2>&1; then
        container_role="$(docker container inspect \
            --format '{{index .Config.Labels "com.dogzilla.role"}}' \
            "${calibration_container}")"
        if [[ "${container_role}" != 'camera-calibration' ]]; then
            printf 'Unexpected container owns reserved name: %s\n' \
                "${calibration_container}" >&2
            return 1
        fi
        printf 'Stopping interrupted camera calibration session.\n'
        docker stop --time 20 "${calibration_container}" >/dev/null
        docker rm "${calibration_container}" >/dev/null 2>&1 || true
    fi
    if [[ ! -f "${CAMERA_CALIBRATION_STATE}" ]]; then
        return
    fi
    IFS= read -r pending_directory < "${CAMERA_CALIBRATION_STATE}"
    if [[ "$(dirname -- "${pending_directory}")" \
            != "${REPO_ROOT}/calibration" \
        || ! "$(basename -- "${pending_directory}")" \
            =~ ^\.camera-calibration\.[A-Za-z0-9]+$ ]]; then
        printf 'Unsafe camera-calibration state path; refusing cleanup: %s\n' \
            "${pending_directory}" >&2
        return 1
    fi
    pending_path="${pending_directory}/camera.yaml"
    if [[ -f "${pending_path}" ]]; then
        if validate_camera_intrinsics_file "${pending_path}"; then
            install_camera_intrinsics_file "${pending_path}"
            printf 'Recovered committed camera intrinsics after interruption.\n'
        else
            printf 'Discarding invalid interrupted calibration result.\n' >&2
        fi
    fi
    rm -f -- "${pending_path}"
    rmdir -- "${pending_directory}" 2>/dev/null || true
    rm -f -- "${CAMERA_CALIBRATION_STATE}"
}

calibrate_camera_intrinsics() {
    local board_columns
    local board_rows
    local board_size="${1:-}"
    local calibration_container='dogzilla_camera_calibration'
    local calibration_status
    local cleanup_directory=''
    local display_access=false
    local pending_name
    local pending_path=''
    local square_size="${2:-}"

    if (($# != 2)); then
        printf '%s\n' \
            'Usage: dogzilla camera-calibrate BOARD_SIZE SQUARE_METRES' \
            'Example: dogzilla camera-calibrate 8x6 0.025' >&2
        return 2
    fi
    if [[ ! "${board_size}" =~ ^([0-9]+)x([0-9]+)$ ]]; then
        printf 'BOARD_SIZE must look like 8x6 and count inner corners.\n' >&2
        return 2
    fi
    board_columns="${BASH_REMATCH[1]}"
    board_rows="${BASH_REMATCH[2]}"
    if ((board_columns < 3 || board_columns > 30 \
        || board_rows < 3 || board_rows > 30)); then
        printf 'Each BOARD_SIZE dimension must be between 3 and 30.\n' >&2
        return 2
    fi
    if ! python3 -c '
import math, sys
value = float(sys.argv[1])
raise SystemExit(0 if math.isfinite(value) and 0.001 <= value <= 0.5 else 1)
' "${square_size}" 2>/dev/null; then
        printf 'SQUARE_METRES must be between 0.001 and 0.5 metres.\n' >&2
        return 2
    fi
    reconcile_camera_calibration
    if container_is_running || drive_is_running || navigation_is_running \
        || shadow_is_running; then
        printf 'Stop the active DOGZILLA mode before camera calibration.\n' >&2
        printf 'Run "dogzilla stop" first.\n' >&2
        return 1
    fi
    if [[ ! -c /dev/video0 ]]; then
        printf 'Camera device is missing: /dev/video0\n' >&2
        return 1
    fi
    ensure_runtime_directories
    ensure_image
    select_local_display
    require_command xhost
    stop_vendor_application
    assert_camera_free

    cleanup_directory="$(mktemp -d \
        "${REPO_ROOT}/calibration/.camera-calibration.XXXXXX")"
    pending_path="${cleanup_directory}/camera.yaml"
    pending_name="${cleanup_directory##*/}/camera.yaml"
    printf '%s\n' "${cleanup_directory}" \
        > "${CAMERA_CALIBRATION_STATE}.tmp"
    mv -f -- \
        "${CAMERA_CALIBRATION_STATE}.tmp" \
        "${CAMERA_CALIBRATION_STATE}"

    cleanup_camera_calibration() {
        docker stop --time 20 "${calibration_container}" \
            >/dev/null 2>&1 || true
        if [[ "${display_access}" == true ]]; then
            if xhost -SI:localuser:root >/dev/null 2>&1; then
                rm -f -- "${CAMERA_CALIBRATION_XHOST_STATE}"
            fi
        fi
        if [[ -n "${pending_path}" ]]; then
            rm -f -- "${pending_path}"
        fi
        if [[ -n "${cleanup_directory}" ]]; then
            rmdir -- "${cleanup_directory}" 2>/dev/null || true
        fi
        rm -f -- \
            "${CAMERA_CALIBRATION_STATE}" \
            "${CAMERA_CALIBRATION_STATE}.tmp"
    }
    trap cleanup_camera_calibration EXIT INT TERM

    xhost +SI:localuser:root >/dev/null
    : > "${CAMERA_CALIBRATION_XHOST_STATE}"
    display_access=true
    printf '%s\n' \
        'Camera calibration opens on the Raspberry Pi monitor.' \
        'Keep DOGZILLA stationary; move only the checkerboard.' \
        'Fill all four coverage bars, click CALIBRATE, inspect the result,' \
        'then click COMMIT. Closing the window without COMMIT changes nothing.'

    set +e
    docker run \
        --rm \
        --interactive \
        --name "${calibration_container}" \
        --init \
        --stop-signal SIGINT \
        --label com.dogzilla.role=camera-calibration \
        --network none \
        --device /dev/video0:/dev/video0 \
        --env DISPLAY="${DISPLAY}" \
        --env QT_X11_NO_MITSHM=1 \
        --env ROS_DOMAIN_ID=115 \
        --env ROS_LOCALHOST_ONLY=1 \
        --env ROS_LOG_DIR=/tmp/ros-logs \
        --volume /tmp/.X11-unix:/tmp/.X11-unix:rw \
        --volume "${REPO_ROOT}/calibration:/calibration:rw" \
        "${IMAGE_NAME}" \
        timeout --signal=INT --kill-after=30s 1800s \
        ros2 launch dogzilla_slam camera_calibration.launch.py \
            enabled:=true \
            board_size:="${board_size}" \
            square_size:="${square_size}" \
            camera_info_url:="file:///calibration/${pending_name}"
    calibration_status=$?
    set -e

    if ((calibration_status != 0)); then
        printf 'Camera calibration exited with status %d; nothing installed.\n' \
            "${calibration_status}" >&2
        cleanup_camera_calibration
        trap - EXIT INT TERM
        unset -f cleanup_camera_calibration
        return "${calibration_status}"
    fi
    if [[ ! -f "${pending_path}" ]]; then
        printf 'No committed calibration was received; camera.yaml is unchanged.\n' \
            >&2
        cleanup_camera_calibration
        trap - EXIT INT TERM
        unset -f cleanup_camera_calibration
        return 1
    fi
    if ! validate_camera_intrinsics_file "${pending_path}"; then
        printf 'Committed calibration failed validation; camera.yaml is unchanged.\n' \
            >&2
        cleanup_camera_calibration
        trap - EXIT INT TERM
        unset -f cleanup_camera_calibration
        return 1
    fi

    install_camera_intrinsics_file "${pending_path}"
    printf 'Validated camera intrinsics installed: %s\n' \
        "${CAMERA_INTRINSICS_FILE}"

    cleanup_camera_calibration
    trap - EXIT INT TERM
    unset -f cleanup_camera_calibration
}

set_camera_extrinsics() {
    local backup_path
    local pending_path

    if (($# != 7)) || [[ "${1:-}" != '--measured' ]]; then
        printf '%s\n' \
            'Usage: dogzilla camera-extrinsics --measured X Y Z ROLL PITCH YAW' \
            'XYZ is metres; roll, pitch, and yaw are degrees.' >&2
        return 2
    fi
    ensure_runtime_directories
    pending_path="$(mktemp \
        "${REPO_ROOT}/calibration/.camera-extrinsics.XXXXXX.yaml")"
    if ! python3 "${CAMERA_MODEL_HELPER}" \
        --write-extrinsics "${pending_path}" \
        --translation "${2}" "${3}" "${4}" \
        --rotation-degrees "${5}" "${6}" "${7}" \
        --confirm-measured; then
        rm -f -- "${pending_path}"
        return 1
    fi
    if [[ -f "${CAMERA_EXTRINSICS_FILE}" ]]; then
        backup_path="${REPO_ROOT}/calibration/camera_extrinsics.backup.$(
            date -u '+%Y%m%dT%H%M%SZ'
        ).yaml"
        cp --preserve=mode,timestamps \
            "${CAMERA_EXTRINSICS_FILE}" "${backup_path}"
        printf 'Previous extrinsics backed up: %s\n' "${backup_path}"
    fi
    mv -f -- "${pending_path}" "${CAMERA_EXTRINSICS_FILE}"
    printf 'Measured camera extrinsics installed: %s\n' \
        "${CAMERA_EXTRINSICS_FILE}"
}

check_camera() {
    local camera_container='dogzilla_camera_check'
    local cleanup_status=0
    local duration="${1:-8}"
    local validation_status=0
    reconcile_camera_calibration
    if [[ ! "${duration}" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
        printf 'SECONDS must be a positive number.\n' >&2
        exit 1
    fi
    if [[ ! -c /dev/video0 ]]; then
        printf 'Camera device is missing: /dev/video0\n' >&2
        exit 1
    fi
    if shadow_is_running; then
        printf 'The shadow service already owns /dev/video0.\n' >&2
        exit 1
    fi
    ensure_image
    stop_vendor_application
    assert_camera_free

    if docker container inspect "${camera_container}" >/dev/null 2>&1; then
        printf 'Temporary camera container already exists: %s\n' \
            "${camera_container}" >&2
        printf 'Stop it before retrying camera-check.\n' >&2
        return 1
    fi
    if ! docker run \
        --rm \
        --detach \
        --name "${camera_container}" \
        --init \
        --stop-signal SIGINT \
        --network host \
        --device /dev/video0:/dev/video0 \
        --env ROS_DOMAIN_ID=113 \
        "${IMAGE_NAME}" \
        ros2 launch dogzilla_slam mono_camera.launch.py \
            enabled:=true rectify:=false \
            camera_info_url:=file:///tmp/dogzilla-uncalibrated.yaml \
            >/dev/null; then
        return 1
    fi

    trap 'docker stop --time 20 dogzilla_camera_check >/dev/null 2>&1 || true' \
        EXIT INT TERM
    set +e
    docker exec "${camera_container}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        timeout 12 bash -c '\''
            until ros2 topic list --no-daemon --spin-time 2 \
                    | grep -qx /camera/image_raw; do
                sleep 0.5
            done
        '\''
    '
    validation_status=$?
    if ((validation_status == 0)); then
        docker exec "${camera_container}" bash -lc '
            source /opt/ros/humble/setup.bash
            source /root/yahboomcar_ws/install/setup.bash
            exec ros2 run dogzilla_slam camera_validate --duration "$1"
        ' _ "${duration}"
        validation_status=$?
    fi
    docker stop --time 20 "${camera_container}" >/dev/null
    cleanup_status=$?
    set -e
    trap - EXIT INT TERM

    if ((cleanup_status != 0)); then
        printf 'Camera validation container did not stop cleanly.\n' >&2
        return 1
    fi
    return "${validation_status}"
}

check_shadow() {
