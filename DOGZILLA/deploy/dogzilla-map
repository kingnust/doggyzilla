validate_vision_color() {
    local color="${1:-red}"
    case "${color}" in
        red|green|blue|yellow)
            printf '%s\n' "${color}"
            ;;
        *)
            printf 'COLOR must be red, green, blue, or yellow.\n' >&2
            return 2
            ;;
    esac
}

validate_vision_control_mode() {
    local mode
    mode="$(validate_vision_mode "${1:-}")"
    case "${mode}" in
        color-action|watchdog|qr-action|line-follow)
            printf '%s\n' "${mode}"
            ;;
        *)
            printf '%s\n' \
                'Armed MODE must be color-action, watchdog, qr-action, or line-follow.' >&2
            return 2
            ;;
    esac
}

start_vision() {
    local mode
    local color
    assert_mission_allows_start
    mode="$(validate_vision_mode "${1:-raw}")"
    color="$(validate_vision_color "${2:-red}")"
    if [[ "${mode}" == objects || "${mode}" == floor-hazards ]]; then
        require_object_model
    fi
    if container_is_running || drive_is_running || navigation_is_running \
        || shadow_is_running || vision_device_is_running; then
        printf 'Another camera or DOGZILLA mode is running. Stop it first.\n' >&2
        printf 'Run "dogzilla stop" first.\n' >&2
        return 1
    fi
    if [[ ! -c /dev/video0 ]]; then
        printf 'Camera device is missing: /dev/video0\n' >&2
        return 1
    fi
    ensure_image
    stop_vendor_application
    assert_camera_free
    begin_log_session
    DOGZILLA_VISION_MODE="${mode}"
    DOGZILLA_VISION_COLOR="${color}"
    export DOGZILLA_VISION_MODE DOGZILLA_VISION_COLOR
    if ! compose up \
        --detach \
        --no-build \
        --force-recreate \
            "${VISION_SERVICE_NAME}"; then
        return 1
    fi
    printf '%s\n' "${DOGZILLA_LOG_SESSION}" > "${VISION_STATE_FILE}.tmp"
    mv -f -- "${VISION_STATE_FILE}.tmp" "${VISION_STATE_FILE}"
    if ! "${WEB_COMMAND}" start; then
        printf 'Vision dashboard startup failed; stopping the camera service.\n' >&2
        compose stop --timeout 20 "${VISION_SERVICE_NAME}" || true
        rm -f -- "${VISION_STATE_FILE}" "${VISION_STATE_FILE}.tmp"
        return 1
    fi
    printf 'DOGZILLA Vision started: mode=%s, color=%s.\n' \
        "${mode}" "${color}"
    printf 'Robot action output is disabled; no serial device is exposed.\n'
    printf 'The authenticated Vision Lab dashboard is starting automatically.\n'
    printf 'Run "dogzilla mission token" for its login token.\n'
}

start_vision_control() {
    local color
    local confirmation
    local mode
    assert_mission_allows_start
    mode="$(validate_vision_control_mode "${1:-}")"
    color="$(validate_vision_color "${2:-red}")"
    if container_is_running || drive_is_running || navigation_is_running \
        || shadow_is_running || vision_device_is_running; then
        printf 'Another camera or DOGZILLA mode is running. Stop it first.\n' >&2
        printf 'Run "dogzilla stop" first.\n' >&2
        return 1
    fi
    if [[ ! -c /dev/video0 ]]; then
        printf 'Camera device is missing: /dev/video0\n' >&2
        return 1
    fi
    printf '%s\n' \
        'WARNING: this session can move DOGZILLA from camera detections.' \
        'Place it on a clear, level floor with room to complete actions.' \
        'Keep hands, cables, stairs, pets, and obstacles out of reach.' \
        'Battery lockout, slow line speed, debounce, cooldown, and stop watchdog remain active.'
    printf 'Type ARM VISION to continue: '
    read -r confirmation
    if [[ "${confirmation}" != 'ARM VISION' ]]; then
        printf 'Cancelled; no camera or robot serial device was opened.\n'
        return 1
    fi

    ensure_image
    stop_vendor_application
    pause_oled_service
    if ! assert_serial_ports_free /dev/ttyAMA0; then
        restore_oled_service
        return 1
    fi
    if ! assert_camera_free; then
        restore_oled_service
        return 1
    fi
    begin_log_session
    DOGZILLA_VISION_MODE="${mode}"
    DOGZILLA_VISION_COLOR="${color}"
    export DOGZILLA_VISION_MODE DOGZILLA_VISION_COLOR
    if ! compose up \
        --detach \
        --no-build \
        --force-recreate \
        "${VISION_CONTROL_SERVICE_NAME}"; then
        restore_oled_service
        return 1
    fi
    printf '%s\n' "${DOGZILLA_LOG_SESSION}" > "${VISION_STATE_FILE}.tmp"
    mv -f -- "${VISION_STATE_FILE}.tmp" "${VISION_STATE_FILE}"
    if ! "${WEB_COMMAND}" start; then
        printf 'Vision dashboard startup failed; stopping armed control.\n' >&2
        compose stop --timeout 20 "${VISION_CONTROL_SERVICE_NAME}" || true
        rm -f -- "${VISION_STATE_FILE}" "${VISION_STATE_FILE}.tmp"
        restore_oled_service
        return 1
    fi
    printf 'ARMED Vision Control started: mode=%s, color=%s.\n' \
        "${mode}" "${color}"
    printf 'LiDAR is off. Run "dogzilla stop" to disarm and stop immediately.\n'
    printf 'Run "dogzilla mission token" for the dashboard token.\n'
}

set_vision_mode() {
    local mode
    local color
    local vision_service
    if vision_control_is_running; then
        mode="$(validate_vision_control_mode "${1:-}")"
    else
        mode="$(validate_vision_mode "${1:-}")"
    fi
    color="$(validate_vision_color "${2:-red}")"
    if vision_control_is_running; then
        vision_service="${VISION_CONTROL_SERVICE_NAME}"
    elif vision_is_running; then
        vision_service="${VISION_SERVICE_NAME}"
    elif perception_is_running; then
        vision_service="${PERCEPTION_SERVICE_NAME}"
    elif shadow_is_running; then
        vision_service="${SHADOW_SERVICE_NAME}"
    else
        printf 'DOGZILLA Vision, perception, or visual-shadow mode is not running.\n' >&2
        return 1
    fi
    compose exec --no-TTY "${vision_service}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
        ros2 param set /dogzilla_vision color "$2"
        ros2 param set /dogzilla_vision mode "$1"
    ' _ "${mode}" "${color}"
    if [[ "${vision_service}" == "${VISION_CONTROL_SERVICE_NAME}" ]]; then
        printf 'ARMED vision mode requested: %s, color=%s; motion may occur.\n' \
            "${mode}" "${color}"
    else
        printf 'Vision mode requested: %s, color=%s; robot actions remain disabled.\n' \
            "${mode}" "${color}"
    fi
}

select_local_display() {
    local display_number

    if [[ "${DISPLAY:-}" =~ ^:([0-9]+)(\.[0-9]+)?$ ]]; then
        display_number="${BASH_REMATCH[1]}"
        if [[ -S "/tmp/.X11-unix/X${display_number}" ]]; then
            return
        fi
    fi
    for display_number in {0..9}; do
        if [[ -S "/tmp/.X11-unix/X${display_number}" ]]; then
            DISPLAY=":${display_number}"
            export DISPLAY
            printf 'Using the Pi desktop display %s.\n' "${DISPLAY}"
            return
        fi
    done
    printf '%s\n' \
        'Camera calibration requires the Raspberry Pi desktop.' \
        'Log into the Pi monitor desktop, then retry from a terminal.' >&2
    return 1
}

