        source /root/yahboomcar_ws/install/setup.bash
        export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
        ros2 param set /dogzilla_safe_base speed_level 1
        ros2 param set /dogzilla_safe_base turn_level 1
    '
}

open_teleop() {
    local speed_level="${1:-5}"
    local control_service
    local output_topic='/cmd_vel'
    local posture_controls=false
    local teleop_status

    if ! control_service="$(active_control_service)"; then
        printf 'No mapping, localization, or drive mode is running.\n' >&2
        printf 'Start one DOGZILLA mode first.\n' >&2
        exit 1
    fi
    if [[ "${control_service}" == "${VISION_CONTROL_SERVICE_NAME}" ]]; then
        printf 'Keyboard teleop is disabled during armed vision control.\n' >&2
        printf 'Run "dogzilla stop", then "dogzilla drive" for teleop.\n' >&2
        exit 1
    fi
    case "${speed_level}" in
        [1-9])
            ;;
        *)
            printf 'Teleop speed level must be a whole number from 1 to 9.\n' >&2
            exit 1
            ;;
    esac

    if [[ "${control_service}" == "${DRIVE_SERVICE_NAME}" ]]; then
        posture_controls=true
    elif [[ "${control_service}" == "${NAVIGATION_SERVICE_NAME}" ]]; then
        output_topic='/cmd_vel_teleop'
    fi

    printf 'Initial teleop speed level: %s\n' "${speed_level}"
    printf 'Press any number from 1 to 9 in teleop to change speed live.\n'
    printf 'Press - to turn slower, or = / + to turn faster.\n'
    if [[ "${posture_controls}" == true ]]; then
        printf 'Body height and look controls are enabled in drive mode.\n'
    fi
    printf 'Movement and turning return to level 1 when teleop closes.\n'

    set +e
    compose exec "${control_service}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
        ros2 run dogzilla_slam teleop --ros-args \
            -p "initial_level:=$1" \
            -p "output_topic:=$2" \
            -p "posture_controls:=$3"
    ' _ "${speed_level}" "${output_topic}" "${posture_controls}"
    teleop_status=$?
    set -e

    if service_is_running "${control_service}" \
        && ! reset_motion_levels "${control_service}"; then
        printf 'Warning: could not restore safe motion levels.\n' >&2
        return 1
    fi
    return "${teleop_status}"
}

open_rviz() {
    local lidar_service
    local rviz_config
    if ! lidar_service="$(active_lidar_service)"; then
        printf 'Mapping or localization is not running.\n' >&2
        exit 1
    fi
    select_local_display
    require_command xhost
    xhost +SI:localuser:root >/dev/null

    if [[ "${lidar_service}" == "${NAVIGATION_SERVICE_NAME}" ]]; then
        rviz_config='/opt/ros/humble/share/nav2_bringup/rviz/nav2_default_view.rviz'
    else
        rviz_config='/root/yahboomcar_ws/install/dogzilla_slam/share/dogzilla_slam/rviz/dogzilla_mapping.rviz'
    fi

    compose exec \
        --env "DISPLAY=${DISPLAY}" \
        "${lidar_service}" \
        bash -lc '
            source /opt/ros/humble/setup.bash
            source /root/yahboomcar_ws/install/setup.bash
            export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
            rviz2 -d "$1"
        ' _ "${rviz_config}"
}

open_shadow_rviz() {
    local rviz_config
    if ! container_is_running || ! shadow_is_running; then
        printf 'Calibrated visual shadow mode is not running.\n' >&2
        printf 'Start it first with "dogzilla shadow --headless".\n' >&2
        exit 1
    fi
    select_local_display
    require_command xhost
    xhost +SI:localuser:root >/dev/null
    rviz_config='/root/yahboomcar_ws/install/dogzilla_slam/share/dogzilla_slam/rviz/dogzilla_shadow.rviz'

    compose exec \
        --env "DISPLAY=${DISPLAY}" \
        "${SERVICE_NAME}" \
        bash -lc '
            source /opt/ros/humble/setup.bash
            source /root/yahboomcar_ws/install/setup.bash
            export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
            rviz2 -d "$1"
        ' _ "${rviz_config}"
}

save_map() {
    local map_name="${1:-}"
    require_running_container

    if [[ -z "${map_name}" ]]; then
        printf 'A map name is required. Example: save room1\n' >&2
        exit 1
    fi
    if [[ ! "${map_name}" =~ ^[A-Za-z0-9._-]+$ ]]; then
        printf 'Map name may contain only letters, numbers, dot, underscore, and dash.\n' >&2
        exit 1
    fi

    compose exec --no-TTY "${SERVICE_NAME}" bash -lc "
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        export ROS_DOMAIN_ID=\"\${ROS_DOMAIN_ID:-12}\"
        ros2 run dogzilla_slam save_map /maps/${map_name}
    "

    ls -lh \
        "${REPO_ROOT}/maps/${map_name}.pbstream" \
        "${REPO_ROOT}/maps/${map_name}.pgm" \
        "${REPO_ROOT}/maps/${map_name}.yaml"
}

open_shell() {
    local control_service
    if ! control_service="$(active_control_service)"; then
        if vision_is_running; then
            control_service="${VISION_SERVICE_NAME}"
        elif perception_is_running; then
            control_service="${PERCEPTION_SERVICE_NAME}"
        else
            printf 'No DOGZILLA ROS mode is running.\n' >&2
            exit 1
        fi
    fi
    compose exec "${control_service}" bash -lc '
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
        exec bash
    '
}

follow_logs() {
    local control_service
    if ! control_service="$(active_control_service)"; then
        if vision_is_running; then
            control_service="${VISION_SERVICE_NAME}"
        else
            printf 'No DOGZILLA ROS mode is running.\n' >&2
            exit 1
        fi
    fi
    if [[ "${control_service}" == "${VISION_CONTROL_SERVICE_NAME}" ]]; then
        compose logs --follow --tail 200 \
            "${VISION_CONTROL_SERVICE_NAME}" web
    elif vision_is_running \
        && [[ "${control_service}" == "${VISION_SERVICE_NAME}" ]]; then
        compose logs --follow --tail 200 \
            "${VISION_SERVICE_NAME}" web
    elif perception_is_running; then
        compose logs --follow --tail 200 \
            "${control_service}" "${PERCEPTION_SERVICE_NAME}" web
    elif shadow_is_running; then
        compose logs --follow --tail 200 \
            "${control_service}" "${SHADOW_SERVICE_NAME}"
    else
        compose logs --follow --tail 200 "${control_service}"
    fi
}

stop_dogzilla() {
    local drive_was_running=false
    local lidar_status=0
    local mapping_was_running=false
    local mission_was_active=false
    local navigation_was_running=false
    local shadow_was_running=false
    local perception_was_running=false
    local vision_was_running=false
    local web_status=0

    reconcile_camera_calibration
    if [[ -f "${VISION_STATE_FILE}" ]]; then
        vision_was_running=true
    fi
    if [[ -f "${MISSION_STATE_FILE}" ]]; then
        mission_was_active=true
        printf 'Stopping the Mission Mode web gateway first.\n'
        if ! "${WEB_COMMAND}" stop; then
            web_status=1
        fi
    fi

    if vision_is_running; then
        vision_was_running=true
        printf 'Stopping the camera-only Vision service first.\n'
        compose stop --timeout 20 "${VISION_SERVICE_NAME}"
    fi
    if vision_control_is_running; then
        vision_was_running=true
        printf 'Disarming and stopping the Vision Control service first.\n'
        compose stop --timeout 20 "${VISION_CONTROL_SERVICE_NAME}"
    fi
    if perception_is_running; then
        perception_was_running=true
        vision_was_running=true
        printf 'Stopping the Mission Mode floor-hazard camera first.\n'
        compose stop --timeout 20 "${PERCEPTION_SERVICE_NAME}"
    fi
    rm -f -- "${VISION_STATE_FILE}" "${VISION_STATE_FILE}.tmp"
    if service_is_running web && [[ "${mission_was_active}" == false ]]; then
        printf 'Stopping the standalone web gateway.\n'
        if ! "${WEB_COMMAND}" stop; then
            web_status=1
        fi
    fi

    if shadow_is_running; then
        shadow_was_running=true
        printf 'Stopping the visual shadow service first.\n'
        compose stop --timeout 20 "${SHADOW_SERVICE_NAME}"
    fi

    if container_is_running; then
        mapping_was_running=true
        compose stop --timeout 20 "${SERVICE_NAME}"
    fi
    if drive_is_running; then
        drive_was_running=true
        compose stop --timeout 10 "${DRIVE_SERVICE_NAME}"
    fi
    if navigation_is_running; then
        navigation_was_running=true
        compose stop --timeout 20 "${NAVIGATION_SERVICE_NAME}"
    fi
    if [[ "${mapping_was_running}" == false \
        && "${drive_was_running}" == false \
        && "${navigation_was_running}" == false \
        && "${shadow_was_running}" == false \
        && "${perception_was_running}" == false \
        && "${vision_was_running}" == false ]]; then
        printf 'DOGZILLA is already stopped.\n'
    fi

    # Mapping may leave the scanner spinning after a process failure. Drive
    # mode never opens ttyAMA1, so it does not need or touch the LiDAR here.
    if [[ "${mapping_was_running}" == true \
        || "${navigation_was_running}" == true \
        || "${shadow_was_running}" == true \
        || ("${drive_was_running}" == false \
            && "${vision_was_running}" == false) ]]; then
        if ! send_lidar_off; then
            lidar_status=1
        fi
    fi
    restore_oled_service

    if [[ -n "${DISPLAY:-}" ]] && command -v xhost >/dev/null 2>&1; then
        xhost -SI:localuser:root >/dev/null 2>&1 || true
    fi

    if ((lidar_status != 0 || web_status != 0)); then
        return 1
    fi
    if [[ "${mission_was_active}" == true ]]; then
        rm -f "${MISSION_STATE_FILE}" "${MISSION_STATE_FILE}.tmp"
    fi
    return 0
}

main() {
    require_command docker
    ensure_runtime_directories

    case "${1:-}" in
        doctor)
            run_doctor
            ;;
        build)
            build_image
            ;;
        start)
            start_mapping "${@:2}"
            ;;
        shadow)
            start_visual_shadow "${@:2}"
            ;;
        vision)
            start_vision "${2:-raw}" "${3:-red}"
            ;;
        vision-control)
            start_vision_control "${2:-}" "${3:-red}"
            ;;
        vision-mode)
            set_vision_mode "${2:-}" "${3:-red}"
            ;;
        object-model-install)
            install_object_model
            ;;
        object-model-custom-install)
            install_custom_object_model "${@:2}"
            ;;
        object-model-yoloe-install)
            install_yoloe_object_model "${@:2}"
            ;;
        object-model-status)
            show_object_model_status
            ;;
        object-check)
            check_object_detection "${@:2}"
            ;;
        object-dataset-capture)
            capture_object_dataset "${2:-}" "${3:-60}" "${4:-1.0}"
            ;;
        camera-check)
            check_camera "${2:-8}"
            ;;
        camera-calibrate)
            calibrate_camera_intrinsics "${@:2}"
            ;;
        camera-extrinsics)
            set_camera_extrinsics "${@:2}"
            ;;
        shadow-check)
            check_shadow "${2:-10}"
            ;;
        shadow-route-check)
            check_shadow_route "${2:-120}" "${3:-1.0}"
            ;;
        shadow-db-check)
            check_shadow_database "${2:-latest}"
            ;;
        drive)
            start_drive
            ;;
        localize)
            start_navigation localize "${@:2}"
            ;;
        navigate)
            start_navigation navigate "${@:2}"
            ;;
        mission)
            "${MISSION_COMMAND}" "${@:2}"
            ;;
        status)
            show_status
            ;;
        teleop)
            open_teleop "${2:-5}"
            ;;
        rviz)
            open_rviz
            ;;
        shadow-rviz)
            open_shadow_rviz
            ;;
        save)
            save_map "${2:-}"
            ;;
        lidar-off)
            send_lidar_off
            ;;
        rest-capture)
            run_firmware_rest_capture
            ;;
        rest)
            run_servo_mode rest
            ;;
        stand)
            run_servo_mode stand
            ;;
        imu-calibrate)
            run_imu_calibration
            ;;
        imu-check)
            check_imu "${2:-8}"
            ;;
        logs)
            follow_logs
            ;;
        shell)
            open_shell
            ;;
        stop)
            stop_dogzilla
            ;;
        desktop-install)
            install_desktop_shortcut
            ;;
        shutdown-install)
            install_shutdown_guard
            ;;
        help|-h|--help|'')
            usage
            ;;
        *)
            printf 'Unknown command: %s\n' "$1" >&2
            usage
            exit 1
            ;;
    esac
}

main "$@"
