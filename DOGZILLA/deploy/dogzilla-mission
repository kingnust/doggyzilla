#!/usr/bin/env bash
set -Eeuo pipefail

DEPLOY_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="${DOGZILLA_MISSION_REPO_ROOT:-$(cd -- "${DEPLOY_DIR}/.." && pwd)}"
MAP_COMMAND="${DOGZILLA_MISSION_MAP_COMMAND:-${DEPLOY_DIR}/dogzilla-map}"
WEB_COMMAND="${DOGZILLA_MISSION_WEB_COMMAND:-${DEPLOY_DIR}/dogzilla-web}"
DOCKER_COMMAND="${DOGZILLA_MISSION_DOCKER_COMMAND:-docker}"
COMPOSE_FILE="${REPO_ROOT}/deploy/compose.yaml"
STATE_FILE="${REPO_ROOT}/logs/mission-current"
NAVIGATION_CONTAINER="dogzilla_navigation"
SHADOW_CONTAINER="dogzilla_visual_shadow"
VISION_CONTAINER="dogzilla_vision"
VISION_CONTROL_CONTAINER="dogzilla_vision_control"
PERCEPTION_CONTAINER="dogzilla_perception"
WEB_CONTAINER="dogzilla_web"
STARTUP_TIMEOUT="${DOGZILLA_MISSION_STARTUP_TIMEOUT:-120}"
CAMERA_DEVICE="${DOGZILLA_MISSION_CAMERA_DEVICE:-/dev/video0}"
OBJECT_MODEL_FILE="${REPO_ROOT}/models/yolox_nano.onnx"
OBJECT_MODEL_SHA256="${DOGZILLA_MISSION_OBJECT_MODEL_SHA256:-c789161ed43c8269fcd4e67c67eeeb4e80c622da2eb296a20bc6007bd18a0b7d}"
OPEN_IMAGES_MODEL_FILE="${REPO_ROOT}/models/yolov8n-oiv7.onnx"
OPEN_IMAGES_MODEL_SHA256="${DOGZILLA_MISSION_OPEN_IMAGES_SHA256:-73c1d27ff67f964b2c43965943fcaa608a09c29a9ea90ff4ef59779c12222870}"

usage() {
    printf '%s\n' \
        'Usage: dogzilla mission COMMAND [ARGUMENTS]' \
        '' \
        'Commands:' \
        '  start [MAP] [--rviz|--headless] [--imu]' \
        '                        Start Nav2, hazard vision, and the dashboard.' \
        '  MAP [--rviz|--headless] [--imu]' \
        '                        Shortcut for "mission start MAP ...".' \
        '  switch-map MAP       Keep camera/web up; restart localization only.' \
        '  status                Show navigation, vision, and dashboard state.' \
        '  logs                  Follow navigation, vision, and dashboard logs.' \
        '  password              Print the browser login password.' \
        '  stop                  Stop dashboard/vision, then navigation safely.'
}

validate_timeout() {
    if [[ ! "${STARTUP_TIMEOUT}" =~ ^[1-9][0-9]*$ ]]; then
        printf 'DOGZILLA_MISSION_STARTUP_TIMEOUT must be a positive integer.\n' >&2
        exit 1
    fi
}

validate_map_name() {
    local map_name="$1"
    local map_path
    if [[ ! "${map_name}" =~ ^[A-Za-z0-9._-]{1,64}$ ]]; then
        printf 'Map name may contain only letters, numbers, dot, underscore, and dash.\n' >&2
        exit 1
    fi
    for map_path in \
        "${REPO_ROOT}/maps/${map_name}.pbstream" \
        "${REPO_ROOT}/maps/${map_name}.yaml" \
        "${REPO_ROOT}/maps/${map_name}.pgm"; do
        if [[ ! -s "${map_path}" ]]; then
            printf 'Required mission map file is missing: %s\n' \
                "${map_path}" >&2
            exit 1
        fi
    done
}

camera_is_ready() {
    if [[ -c "${CAMERA_DEVICE}" ]]; then
        return 0
    fi
    [[ "${CAMERA_DEVICE}" != /dev/video0 && -r "${CAMERA_DEVICE}" ]]
}

container_status() {
    local container_name="$1"
    "${DOCKER_COMMAND}" inspect \
        --format '{{.State.Status}}' \
        "${container_name}" 2>/dev/null
}

container_is_active() {
    local status
    status="$(container_status "$1" || true)"
    case "${status}" in
        ''|created|exited|dead)
            return 1
            ;;
        *)
            return 0
            ;;
    esac
}

container_health() {
    local container_name="$1"
    "${DOCKER_COMMAND}" inspect \
        --format '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' \
        "${container_name}" 2>/dev/null
}

assert_runtime_is_free() {
    local container_name
    for container_name in \
        dogzilla_mapping \
        dogzilla_drive \
        "${NAVIGATION_CONTAINER}" \
        "${SHADOW_CONTAINER}" \
        "${VISION_CONTAINER}" \
        "${VISION_CONTROL_CONTAINER}" \
        "${PERCEPTION_CONTAINER}" \
        "${WEB_CONTAINER}"; do
        if container_is_active "${container_name}"; then
            printf 'Cannot start Mission Mode: %s is already running.\n' \
                "${container_name}" >&2
            printf 'Finish or stop the current DOGZILLA mode first.\n' >&2
            exit 1
        fi
    done
}

write_state() {
    local map_name="$1"
    local state="$2"
    local session="${3:-pending}"
    local display_mode="${4:-headless}"
    local use_imu="${5:-false}"
    local temporary="${STATE_FILE}.tmp"
    mkdir -p "${REPO_ROOT}/logs"
    umask 077
    {
        printf 'state=%s\n' "${state}"
        printf 'map=%s\n' "${map_name}"
        printf 'session=%s\n' "${session}"
        printf 'display=%s\n' "${display_mode}"
        printf 'use_imu=%s\n' "${use_imu}"
        printf 'started_utc=%s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    } > "${temporary}"
    mv -f "${temporary}" "${STATE_FILE}"
}

state_value() {
    local name="$1"
    if [[ ! -f "${STATE_FILE}" ]]; then
        return 1
    fi
    sed -n "s/^${name}=//p" "${STATE_FILE}" | head -n 1
}

wait_for_healthy() {
    local container_name="$1"
    local label="$2"
    local deadline=$((SECONDS + STARTUP_TIMEOUT))
    local health
    while ((SECONDS < deadline)); do
        health="$(container_health "${container_name}" || true)"
        case "${health}" in
            healthy)
                printf '%s is healthy.\n' "${label}"
                return 0
                ;;
            unhealthy|exited|dead)
                printf '%s failed with container state: %s\n' \
                    "${label}" "${health}" >&2
                return 1
                ;;
        esac
        sleep 2
    done
    printf '%s did not become healthy within %s seconds.\n' \
        "${label}" "${STARTUP_TIMEOUT}" >&2
    return 1
}

verify_ros_readiness() {
    "${DOCKER_COMMAND}" exec "${NAVIGATION_CONTAINER}" bash -lc '
        set -e
        source /opt/ros/humble/setup.bash
        source /root/yahboomcar_ws/install/setup.bash
        export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-12}"
        topics="$(ros2 topic list)"
        for topic in /scan /map /odom /battery_state /joint_states; do
            grep -qx "${topic}" <<< "${topics}"
        done
        for topic in \
            /vision/status \
            /vision/detections \
            /vision/danger_confirmed \
            /vision/annotated/compressed; do
            grep -qx "${topic}" <<< "${topics}"
        done
        actions="$(ros2 action list)"
        for action in /navigate_to_pose /compute_path_to_pose; do
            grep -qx "${action}" <<< "${actions}"
        done
        nodes="$(ros2 node list)"
        grep -qx /planner_server <<< "${nodes}"
        grep -qx /bt_navigator <<< "${nodes}"
        timeout 6 bash -c \
            "ros2 run tf2_ros tf2_echo map base_link 2>&1 | grep -m1 -q Translation:"
    '
}

verify_object_model() {
    if [[ ! -f "${OBJECT_MODEL_FILE}" ]] \
        || ! printf '%s  %s\n' \
            "${OBJECT_MODEL_SHA256}" "${OBJECT_MODEL_FILE}" \
            | sha256sum --check --status; then
        printf 'The verified floor-object model is not installed.\n' >&2
        printf 'Run "dogzilla object-model-install", then retry.\n' >&2
        return 1
    fi
    if [[ ! -f "${OPEN_IMAGES_MODEL_FILE}" ]] \
        || ! printf '%s  %s\n' \
            "${OPEN_IMAGES_MODEL_SHA256}" "${OPEN_IMAGES_MODEL_FILE}" \
            | sha256sum --check --status; then
        printf 'The verified Open Images object model is not installed.\n' >&2
        printf 'Run "dogzilla object-model-install", then retry.\n' >&2
        return 1
    fi
}

start_perception() {
    if ! camera_is_ready; then
        printf 'Mission camera is missing or unreadable: %s\n' \
            "${CAMERA_DEVICE}" >&2
        return 1
    fi
    verify_object_model
    "${DOCKER_COMMAND}" compose \
        --project-directory "${REPO_ROOT}" \
        --file "${COMPOSE_FILE}" \
        up --detach --no-build --force-recreate perception
}

stop_components() {
    local status=0
    set +e
    "${WEB_COMMAND}" stop
    if (($? != 0)); then
        status=1
    fi
    "${DOCKER_COMMAND}" compose \
        --project-directory "${REPO_ROOT}" \
        --file "${COMPOSE_FILE}" \
        stop --timeout 20 perception
    if (($? != 0)); then
        status=1
    fi
    "${MAP_COMMAND}" stop
    if (($? != 0)); then
        status=1
    fi
    if ((status == 0)); then
        rm -f "${STATE_FILE}" "${STATE_FILE}.tmp"
    fi
    set -e
    return "${status}"
}

rollback_on_failure() {
    local status=$?
    trap - EXIT INT TERM
    if [[ "${MISSION_STARTUP_COMPLETE:-false}" != true ]]; then
        printf 'Mission Mode startup failed; stopping web and navigation.\n' >&2
        stop_components || true
    fi
    exit "${status}"
}

stop_mission() {
    if [[ ! -f "${STATE_FILE}" ]]; then
        printf 'Mission Mode is not active; no services were stopped.\n'
        return 0
    fi
    stop_components
}

start_mission() {
    local display_mode='headless'
    local map_name='test1'
    local session
    local use_imu=false
    local argument
    local -a navigation_arguments

    if (($# > 0)) && [[ "$1" != --* ]]; then
        map_name="$1"
        shift
    fi
    validate_timeout
    validate_map_name "${map_name}"
    assert_runtime_is_free
    verify_object_model
    if ! camera_is_ready; then
        printf 'Mission camera is missing or unreadable: %s\n' \
            "${CAMERA_DEVICE}" >&2
        exit 1
    fi

    if [[ -e "${STATE_FILE}" ]]; then
        printf 'A previous Mission Mode state file exists: %s\n' \
            "${STATE_FILE}" >&2
        printf 'Run "dogzilla mission stop" before starting again.\n' >&2
        exit 1
    fi

    navigation_arguments=(navigate "${map_name}")
    if (($# == 0)); then
        navigation_arguments+=(--headless)
    else
        navigation_arguments+=("$@")
    fi
    for argument in "${navigation_arguments[@]}"; do
        case "${argument}" in
            --rviz) display_mode='rviz' ;;
            --headless) display_mode='headless' ;;
            --imu) use_imu=true ;;
        esac
    done

    write_state "${map_name}" starting pending "${display_mode}" "${use_imu}"
    MISSION_STARTUP_COMPLETE=false
    trap rollback_on_failure EXIT
    trap 'exit 130' INT
    trap 'exit 143' TERM

    DOGZILLA_MISSION_START=1 \
        "${MAP_COMMAND}" "${navigation_arguments[@]}"
    session="$(sed -n '1p' "${REPO_ROOT}/logs/current-session")"
    if [[ -z "${session}" || ! "${session}" =~ ^[A-Za-z0-9._-]+$ ]]; then
        printf 'Navigation did not create a valid log session.\n' >&2
        return 1
    fi
    export DOGZILLA_ROS_LOG_DIR="/logs/sessions/${session}"
    start_perception
    "${WEB_COMMAND}" start "${map_name}"

    wait_for_healthy "${NAVIGATION_CONTAINER}" 'Navigation'
    wait_for_healthy "${PERCEPTION_CONTAINER}" 'Floor-hazard perception'
    wait_for_healthy "${WEB_CONTAINER}" 'Web gateway'
    if ! verify_ros_readiness; then
        printf 'Mission Mode ROS readiness checks failed.\n' >&2
        return 1
    fi

    write_state "${map_name}" ready "${session}" "${display_mode}" "${use_imu}"
    MISSION_STARTUP_COMPLETE=true
    trap - EXIT INT TERM
    printf '%s\n' \
        'Mission Mode is ready.' \
        "Map: ${map_name}" \
        "ROS logs: logs/sessions/${session}" \
        'Floor-hazard perception is detection-only and camera based.' \
        'No movement has been queued automatically.' \
        'Use "dogzilla mission password" for browser login.'
}

start_navigation_for_switch() {
    local map_name="$1"
    local display_mode="$2"
    local use_imu="$3"
    local -a arguments=(navigate "${map_name}" "--${display_mode}")
    if [[ "${use_imu}" == true ]]; then
        arguments+=(--imu)
    fi
    DOGZILLA_MISSION_START=1 DOGZILLA_MISSION_SWITCH=1 \
        "${MAP_COMMAND}" "${arguments[@]}"
}

stop_navigation_only() {
    "${DOCKER_COMMAND}" compose \
        --project-directory "${REPO_ROOT}" \
        --file "${COMPOSE_FILE}" \
        stop --timeout 20 navigation
}

rollback_map_switch() {
    local old_map="$1"
    local display_mode="$2"
    local use_imu="$3"
    printf 'Map switch failed; restoring map %s.\n' "${old_map}" >&2
    stop_navigation_only || true
    "${WEB_COMMAND}" prepare-map "${old_map}" || return 1
    "${WEB_COMMAND}" switch-map "${old_map}" || return 1
    start_navigation_for_switch \
        "${old_map}" "${display_mode}" "${use_imu}" || return 1
    wait_for_healthy "${NAVIGATION_CONTAINER}" 'Restored navigation' \
        || return 1
    verify_ros_readiness || return 1
    "${WEB_COMMAND}" wait-map "${old_map}" "${STARTUP_TIMEOUT}" || return 1
    return 0
}

switch_mission_map() {
    local map_name="$1"
    local old_map
    local display_mode
    local use_imu
    local session
    validate_timeout
    validate_map_name "${map_name}"
    if [[ ! -f "${STATE_FILE}" ]] \
        || [[ "$(state_value state || true)" != ready ]]; then
        printf 'Mission Mode must be ready before switching maps.\n' >&2
        exit 1
    fi
    old_map="$(state_value map)"
    if [[ "${map_name}" == "${old_map}" ]]; then
        printf 'Mission Mode is already using map %s.\n' "${map_name}"
        return 0
    fi
    display_mode="$(state_value display || true)"
    display_mode="${display_mode:-headless}"
    use_imu="$(state_value use_imu || true)"
    use_imu="${use_imu:-false}"
    if [[ "${display_mode}" != headless && "${display_mode}" != rviz ]]; then
        printf 'Mission state contains an invalid display mode.\n' >&2
        exit 1
    fi
    if [[ "${use_imu}" != true && "${use_imu}" != false ]]; then
        printf 'Mission state contains an invalid IMU setting.\n' >&2
        exit 1
    fi

    write_state \
        "${old_map}" switching "$(state_value session)" \
        "${display_mode}" "${use_imu}"
    if ! "${WEB_COMMAND}" prepare-map "${map_name}"; then
        write_state \
            "${old_map}" ready "$(state_value session)" \
            "${display_mode}" "${use_imu}"
        return 1
    fi
    if ! stop_navigation_only \
        || ! "${WEB_COMMAND}" switch-map "${map_name}" \
        || ! start_navigation_for_switch \
            "${map_name}" "${display_mode}" "${use_imu}" \
        || ! wait_for_healthy "${NAVIGATION_CONTAINER}" 'Navigation' \
        || ! verify_ros_readiness \
        || ! "${WEB_COMMAND}" wait-map \
            "${map_name}" "${STARTUP_TIMEOUT}"; then
        if rollback_map_switch \
            "${old_map}" "${display_mode}" "${use_imu}"; then
            session="$(sed -n '1p' "${REPO_ROOT}/logs/current-session")"
            write_state \
                "${old_map}" ready "${session}" \
                "${display_mode}" "${use_imu}"
        else
            write_state \
                "${old_map}" failed rollback-failed \
                "${display_mode}" "${use_imu}"
            printf 'Automatic rollback failed; Mission Mode needs inspection.\n' >&2
        fi
        return 1
    fi
    session="$(sed -n '1p' "${REPO_ROOT}/logs/current-session")"
    write_state \
        "${map_name}" ready "${session}" \
        "${display_mode}" "${use_imu}"
    printf 'Mission Mode switched to map %s.\n' "${map_name}"
    printf 'Camera, perception, and web gateway stayed online.\n'
}

show_mission_status() {
    if [[ ! -f "${STATE_FILE}" ]]; then
        printf 'Mission Mode is not managed by this command.\n'
    else
        printf 'Mission Mode state: %s\n' "$(state_value state)"
        printf 'Map: %s\n' "$(state_value map)"
        printf 'Log session: %s\n' "$(state_value session)"
    fi
    "${MAP_COMMAND}" status
    "${WEB_COMMAND}" status
}

follow_mission_logs() {
    "${DOCKER_COMMAND}" compose \
        --project-directory "${REPO_ROOT}" \
        --file "${COMPOSE_FILE}" \
        logs --follow --tail 200 navigation perception web
}

main() {
    local command="${1:-}"
    case "${command}" in
        start)
            shift
            start_mission "$@"
            ;;
        switch-map)
            if [[ -z "${2:-}" ]]; then
                printf 'Map name is required.\n' >&2
                exit 1
            fi
            switch_mission_map "$2"
            ;;
        status)
            show_mission_status
            ;;
        logs)
            follow_mission_logs
            ;;
        password|token)
            "${WEB_COMMAND}" show-password
            ;;
        stop)
            stop_mission
            ;;
        help|-h|--help|'')
            usage
            ;;
        --*)
            start_mission "$@"
            ;;
        *)
            start_mission "$@"
            ;;
    esac
}

main "$@"
